            const baseSize = 14;
            const newSize = (baseSize * tamañoFuenteActual) / 100;
            root.style.setProperty('--font-size-base', newSize + 'px');
            document.body.style.fontSize = newSize + 'px';
            const label = document.getElementById('font-size-label');
            if (label) label.textContent = tamañoFuenteActual + '%';
            localStorage.setItem('cocina_movil_font_size', tamañoFuenteActual);
        }

        function cambiarTamanoFuente(incremento) {
            tamañoFuenteActual = Math.min(Math.max(tamañoFuenteActual + incremento * 10, 70), 150);
            aplicarTamañoFuente();
        }

