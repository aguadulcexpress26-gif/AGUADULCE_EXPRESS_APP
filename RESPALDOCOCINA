function cargarHistorialFiltrado() {
    console.log('📌 cargarHistorialFiltrado() - VERSIÓN DEFINITIVA');
    
    const content = document.getElementById('historial-contenido');
    const contador = document.getElementById('col-count-historial');
    const filtro = document.getElementById('filtro-historial');
    
    if (!content) {
        console.log('❌ No se encontró historial-contenido');
        return;
    }
    
    const filtroSeleccionado = filtro ? filtro.value : 'todos';
    console.log('📌 Filtro seleccionado:', filtroSeleccionado);
    
    // Limpiar contenido
    content.innerHTML = '';
    
    db.ref('pedidos').once('value').then(snap => {
        const pedidos = snap.val();
        let count = 0;
        
        if (!pedidos) {
            content.innerHTML = `
                <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2rem;color:#475569;text-align:center;height:100%;min-height:200px;">
                    <div style="font-size:2rem;margin-bottom:0.5rem;">📜</div>
                    <div>No hay pedidos en el historial</div>
