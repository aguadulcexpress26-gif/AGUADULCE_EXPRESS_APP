                                    id: data.id_pedido || id.substring(0, 8),
                                    cliente: data.cliente_nombre || 'Reparto Personal',
                                    base: 0,                          // ← NO aporta a la base
                                    envio: montoReparto,
                                    comision: 0,
                                    demoraMinutos: 0,
                                    descuentoDemora: 0,
                                    liquidar: -montoReparto,          // ← negativo (se resta)
                                    fecha: fecha,
                                    esReparto: true,
                                    montoReparto: montoReparto
                                });
                                
                                continue;
                            }
                            
                            // ----- Pedido normal -----
