                const comisionTipo = comisionTipoGlobal || 'porcentaje';
                const costoDemora = costoDemoraPorMinuto || 0.50;
                
                db.ref('pedidos').once('value').then(snap => {
                    const pedidos = snap.val();
                    if (!pedidos) {
                        content.innerHTML = `<div class="empty"><div class="icon">📊</div><div>No hay datos de ventas</div></div>`;
                        return;
                    }
                    
                    const ahora = new Date();
                    let fechaInicio;
                    
                    switch(periodo) {
                        case 'hoy':
                            fechaInicio = new Date(ahora);
                            fechaInicio.setHours(0, 0, 0, 0);
                            break;
                        case 'semana':
                            fechaInicio = new Date(ahora);
                            const dia = ahora.getDay();
                            const diff = (dia === 0 ? 6 : dia - 1);
                            fechaInicio.setDate(ahora.getDate() - diff);
                            fechaInicio.setHours(0, 0, 0, 0);
                            break;
                        case 'mes':
                            fechaInicio = new Date(ahora.getFullYear(), ahora.getMonth(), 1);
                            fechaInicio.setHours(0, 0, 0, 0);
                            break;
                        case 'quincena':
                            fechaInicio = new Date(ahora);
                            fechaInicio.setDate(ahora.getDate() <= 15 ? 1 : 16);
                            fechaInicio.setHours(0, 0, 0, 0);
                            break;
                        default:
                            fechaInicio = new Date(ahora);
                            fechaInicio.setDate(ahora.getDate() - 7);
                            fechaInicio.setHours(0, 0, 0, 0);
                    }
                    
                    let totalPedidos = 0;
                    let totalRepartos = 0;
                    let totalVentas = 0;              // ← Base acumulada de pedidos NORMALES
                    let totalComisiones = 0;
                    let totalDemoras = 0;
                    let totalDescuentoDemora = 0;
                    let totalRepartosMonto = 0;       // ← Acumulador APARTE de repartos
                    let pedidosDetalle = [];
                    
                  for (const [id, data] of Object.entries(pedidos)) {
    const restId = data.restauranteId || data.restaurante_id || data.uid_restaurante;
    if (restId !== restauranteId) continue;
    
    // ✅ Excluir pedidos ya liquidados (evita doble conteo)
    if (data.liquidado === true) continue;
    
    const fecha = new Date(data.fecha || data.timestamp || 0);
    if (fecha < fechaInicio) continue;
    // ...
                        
                        if (data.estado === 'ENTREGADO' || data.estado === 'LISTO') {
                            
