    } catch (error) {
        console.error('Error cargando impresora:', error);
        impresoraConfigurada = false;
        actualizarIconoImpresora();
    }
}

async function conectarYGuardarImpresora(device) {
    try {
        if (impresoraConectada) {
            try { await impresoraConectada.server.disconnect(); } catch(e) {}
            impresoraConectada = null;
            impresoraCharacteristic = null;
        }

        const server = await device.gatt.connect();
        const service = await server.getPrimaryService('000018f0-0000-1000-8000-00805f9b34fb');
        const characteristic = await service.getCharacteristic('00002af1-0000-1000-8000-00805f9b34fb');

        impresoraConectada = { device, server, service, characteristic };
        impresoraDevice = device;
        impresoraCharacteristic = characteristic;

        return impresoraConectada;
    } catch (error) {
        console.error('❌ Error conectando:', error);
        throw error;
    }
}

// ✅ Reintentar conexión silenciosa (necesita gesto previo del usuario en muchas versiones de Chrome)
async function conectarImpresoraGuardada() {
    if (impresoraConectada && impresoraCharacteristic) {
        try {
            if (impresoraConectada.device.gatt.connected) {
                return impresoraConectada;
            } else {
                impresoraConectada = null;
                impresoraCharacteristic = null;
            }
        } catch(e) {
            impresoraConectada = null;
            impresoraCharacteristic = null;
        }
    }

    if (!impresoraConfigurada || !navigator.bluetooth) return null;

    try {
        const device = await navigator.bluetooth.requestDevice({
            filters: [
                { services: ['000018f0-0000-1000-8000-00805f9b34fb'] },
                { name: nombreImpresora }
            ],
            optionalServices: ['000018f0-0000-1000-8000-00805f9b34fb']
        });

        if (device) {
            const connection = await conectarYGuardarImpresora(device);
            actualizarIconoImpresora();
            return connection;
        }
        return null;

    } catch (error) {
        console.warn('⚠️ Error conectando:', error);
        actualizarIconoImpresora();
        return null;
    }
}

