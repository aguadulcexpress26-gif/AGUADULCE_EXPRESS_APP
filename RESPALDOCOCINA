                colCoccion.innerHTML = '';
                
                mostrarMensajeVacio('col-pendiente', '⏳', 'Cargando pedidos...');
                mostrarMensajeVacio('col-coccion', '⏳', 'Cargando pedidos...');
                
                db.ref('pedidos').once('value').then((snapshot) => {
                    const pedidos = snapshot.val();
                    let pendiente = 0, coccion = 0, demoras = 0;
                    
                    if (!pedidos) {
                        mostrarMensajeVacio('col-pendiente', '📥', 'No hay pedidos en entrada');
                        mostrarMensajeVacio('col-coccion', '👨‍🍳', 'No hay pedidos en cocción');
                        actualizarContadores(0, 0, 0);
                        return;
                    }
                    
                    colPendiente.innerHTML = '';
                    colCoccion.innerHTML = '';
                    
                    const idsProcesados = new Set();
                    let pedidosPendientes = [];
                    let pedidosCoccion = [];
                    
                    for (const [id, data] of Object.entries(pedidos)) {
                        const restId = data.restauranteId || data.restaurante_id || data.uid_restaurante;
                        if (restId !== restauranteId) continue;
                        
                        if (idsProcesados.has(id)) continue;
                        idsProcesados.add(id);
                        
                        let estado = data.estado ? data.estado.toLowerCase() : '';
                        if (estado === 'recibido') estado = 'pendiente';
                        
                        if (estado === 'pendiente') {
                            pendiente++;
                            pedidosPendientes.push({ id, data: { ...data, estado } });
                        } else if (estado === 'coccion') {
                            coccion++;
                            const demora = data.demora || data.tiempo_demora || 0;
                            if (demora > 0) demoras++;
                            pedidosCoccion.push({ id, data: { ...data, estado } });
                        }
                    }
                    
                    if (pedidosPendientes.length === 0) {
                        mostrarMensajeVacio('col-pendiente', '📥', 'No hay pedidos en entrada');
                    } else {
                        for (const item of pedidosPendientes) {
                            agregarPedidoAColumna(item.id, item.data);
                        }
                    }
                    
                    if (pedidosCoccion.length === 0) {
                        mostrarMensajeVacio('col-coccion', '👨‍🍳', 'No hay pedidos en cocción');
                    } else {
                        for (const item of pedidosCoccion) {
                            agregarPedidoAColumna(item.id, item.data);
                        }
                    }
                    
                    actualizarContadores(pendiente, coccion, demoras);
                    
