<!DOCTYPE html>
<html lang="es">
<head>
    <!-- ============================================
    METADATOS BÁSICOS
    ============================================ -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Aguadulce Express - Cocina Móvil</title>
    
    <!-- ============================================
    PWA CONFIGURACIÓN
    ============================================ -->
    <link rel="manifest" href="/cocina-movil/manifest.json">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Aguadulce Cocina">
    <link rel="apple-touch-icon" href="https://i.postimg.cc/cCv7qsHf/IMAGEN-PNG-512.jpg">
    
    <!-- ============================================
    SCRIPTS CDN
    ============================================ -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-messaging-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-functions-compat.js"></script>
    
    <!-- ============================================
    FUENTES
    ============================================ -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- ============================================
    ESTILOS
    ============================================ -->
    <style>
        /* ============================================
           RESET Y VARIABLES
           ============================================ */
        :root {
            --bg-primary: #0a0e17;
            --bg-secondary: #111827;
            --bg-card: #1a2234;
            --bg-card-hover: #243049;
            --border-color: #2a3a5a;
            --text-primary: #f1f5f9;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent-gold: #f59e0b;
            --accent-blue: #3b82f6;
            --accent-green: #10b981;
            --accent-red: #ef4444;
            --accent-purple: #8b5cf6;
            --shadow: 0 8px 32px rgba(0,0,0,0.4);
            --radius: 16px;
            --radius-sm: 10px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --font-size-base: 14px;
        }
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            font-size: var(--font-size-base);
        }
        
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: var(--bg-secondary); border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: var(--accent-gold); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #d97706; }
        
        /* ============================================
           LOGIN
           ============================================ */
        #login-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            background: var(--bg-primary);
            padding: 1rem;
            position: fixed;
            inset: 0;
            z-index: 100;
            transition: opacity 0.5s ease, visibility 0.5s ease;
        }
        #login-container.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }
        
        .login-card {
            background: var(--bg-card);
            border-radius: var(--radius);
            padding: 2.5rem 1.5rem;
            width: 100%;
            max-width: 400px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow);
            animation: fadeInUp 0.6s ease-out;
        }
        
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .login-card .logo { text-align: center; margin-bottom: 1.5rem; }
        .login-card .logo h1 { font-size: 1.8rem; font-weight: 900; color: var(--accent-gold); letter-spacing: -0.5px; }
        .login-card .logo p { color: var(--text-secondary); font-size: 0.8rem; }
        
        .login-card input {
            width: 100%;
            padding: 0.75rem 1rem;
            background: var(--bg-secondary);
            border: 2px solid var(--border-color);
            border-radius: var(--radius-sm);
            font-size: 0.95rem;
            color: var(--text-primary);
            transition: var(--transition);
            outline: none;
        }
        .login-card input:focus { border-color: var(--accent-gold); box-shadow: 0 0 0 3px rgba(245,158,11,0.15); }
        .login-card input::placeholder { color: var(--text-muted); }
        
        .login-card .btn-login {
            width: 100%;
            padding: 0.75rem;
            background: linear-gradient(135deg, var(--accent-gold), #d97706);
            color: #0f172a;
            border: none;
            border-radius: var(--radius-sm);
            font-size: 0.95rem;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
        }
        .login-card .btn-login:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(245,158,11,0.3); }
        .login-card .btn-login:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
        
        /* ============================================
           APP LAYOUT
           ============================================ */
        #app {
            display: none;
            width: 100vw;
            height: 100vh;
            height: 100dvh;
            background: var(--bg-primary);
            position: fixed;
            inset: 0;
            z-index: 10;
        }
        #app:not(.hidden) { display: flex; flex-direction: column; }
        
        /* ============================================
           TOP BAR
           ============================================ */
        .top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.3rem 0.5rem;
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--border-color);
            flex-shrink: 0;
            min-height: 40px;
            z-index: 20;
        }
        
        .top-bar .brand {
            font-weight: 900;
            font-size: 0.8rem;
            color: var(--accent-gold);
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }
        
        .top-bar .brand span {
            font-size: 0.5rem;
            color: var(--text-muted);
            font-weight: 400;
        }
        
        .top-bar .header-actions {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }
        
        #estado-restaurante {
            font-size: 0.5rem;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 50px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            white-space: nowrap;
        }
        
        .top-bar .header-actions .btn-pausa {
            padding: 0.1rem 0.5rem;
            border-radius: 50px;
            border: none;
            font-weight: 600;
            font-size: 0.6rem;
            cursor: pointer;
            transition: var(--transition);
            white-space: nowrap;
        }
        .top-bar .header-actions .btn-pausa.active { background: var(--accent-red); color: white; }
        .top-bar .header-actions .btn-pausa.inactive { background: var(--accent-green); color: white; }
        
        #estado-banner { display: none; }
        #estado-banner.active { display: block; }
        #estado-banner .banner-content {
            background: var(--accent-red);
            color: white;
            text-align: center;
            padding: 4px 8px;
            font-weight: 700;
            font-size: 0.6rem;
        }
        
        #pausa-banner {
            display: none;
            background: var(--accent-red);
            color: white;
            text-align: center;
            padding: 3px;
            font-weight: 600;
            font-size: 0.6rem;
            flex-shrink: 0;
        }
        
        /* ============================================
           STATS BAR
           ============================================ */
        .stats-bar {
            display: flex;
            gap: 0.3rem;
            padding: 0.2rem 0.5rem;
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--border-color);
            flex-shrink: 0;
            flex-wrap: wrap;
            align-items: center;
        }
        
        .stat-item {
            display: flex;
            align-items: center;
            gap: 0.2rem;
            padding: 0.1rem 0.4rem;
            background: var(--bg-card);
            border-radius: 50px;
            border: 1px solid var(--border-color);
        }
        .stat-item .icon { font-size: 0.7rem; }
        .stat-item .label { font-size: 0.5rem; color: var(--text-muted); }
        .stat-item .value { font-size: 0.7rem; font-weight: 700; min-width: 14px; text-align: center; }
        .stat-item .value.gold { color: var(--accent-gold); }
        .stat-item .value.blue { color: var(--accent-blue); }
        
        /* ============================================
           KANBAN
           ============================================ */
        .kanban-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            padding: 0.3rem;
            overflow-y: auto;
            background: var(--bg-primary);
            min-height: 0;
        }
        
        .kanban-column {
            flex: 1;
            min-height: 35vh;
            max-height: 45vh;
            background: var(--bg-secondary);
            border-radius: var(--radius);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border: 1px solid var(--border-color);
        }
        
        .kanban-column .column-header {
            padding: 0.3rem 0.6rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--border-color);
            flex-shrink: 0;
            background: var(--bg-secondary);
        }
        .kanban-column .column-header .title {
            font-weight: 700;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }
        .kanban-column .column-header .count {
            background: var(--bg-card);
            padding: 0.05rem 0.4rem;
            border-radius: 50px;
            font-size: 0.55rem;
            font-weight: 700;
        }
        
        .kanban-column.pending .column-header { border-bottom-color: var(--accent-gold); }
        .kanban-column.pending .column-header .title { color: var(--accent-gold); }
        
        .kanban-column.cooking .column-header { border-bottom-color: var(--accent-blue); }
        .kanban-column.cooking .column-header .title { color: var(--accent-blue); }
        
        .kanban-column .column-content {
            flex: 1;
            overflow-y: auto;
            padding: 0.3rem;
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }
        
        /* ============================================
           TARJETAS DE PEDIDOS
           ============================================ */
        .order-card {
            background: var(--bg-card);
            border-radius: var(--radius-sm);
            padding: 0.8rem 0.8rem;
            border: 1px solid var(--border-color);
            transition: var(--transition);
            flex-shrink: 0;
            margin-bottom: 0.5rem;
        }
        .order-card:hover { border-color: var(--accent-gold); }
        .order-card.delayed {
            border-left: 4px solid var(--accent-red);
            background: rgba(239,68,68,0.05);
        }

        .order-card .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.3rem;
        }

        .order-card .top .id {
            font-size: 1.2rem;
            font-weight: 900;
            font-family: 'Courier New', monospace;
            color: #0f172a;
            background: var(--accent-gold);
            padding: 0.2rem 0.8rem;
            border-radius: 6px;
            letter-spacing: 0.5px;
            box-shadow: 0 0 15px rgba(245,158,11,0.3);
            display: inline-block;
        }
        .order-card .top .id.pendiente { background: #f59e0b; color: #0f172a; }
        .order-card .top .id.coccion { background: #3b82f6; color: white; }

        .order-card .top .time {
            font-size: 0.6rem;
            color: var(--text-muted);
        }

        .order-card .cliente {
            font-weight: 700;
            font-size: 1rem;
            color: var(--text-primary);
            margin-bottom: 0.1rem;
        }

        .order-card .direccion {
            font-size: 0.75rem;
            color: var(--text-secondary);
        }

        .order-card .telefono {
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        .order-card .timer {
            display: flex;
            align-items: center;
            gap: 0.3rem;
            padding: 0.2rem 0.5rem;
            background: var(--bg-secondary);
            border-radius: var(--radius-sm);
            margin: 0.3rem 0;
            font-size: 0.7rem;
            border: 1px solid var(--border-color);
        }
        .order-card .timer .label { color: var(--text-muted); }
        .order-card .timer .value { font-weight: 700; color: var(--accent-gold); font-size: 0.8rem; }
        .order-card .timer .value.delayed { color: var(--accent-red); }

        .order-card .productos {
            display: flex;
            flex-wrap: wrap;
            gap: 0.3rem;
            margin: 0.3rem 0;
        }
        .order-card .productos span {
            background: var(--bg-secondary);
            padding: 0.1rem 0.5rem;
            border-radius: 50px;
            font-size: 0.65rem;
            color: var(--text-secondary);
            border: 1px solid var(--border-color);
        }

        .order-card .footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 0.3rem;
            padding-top: 0.3rem;
            border-top: 1px solid var(--border-color);
            flex-wrap: wrap;
            gap: 0.3rem;
        }
        .order-card .footer .precio {
            font-weight: 700;
            color: var(--accent-gold);
            font-size: 0.9rem;
        }
        .order-card .footer .badge-estado {
            font-size: 0.6rem;
            padding: 0.1rem 0.5rem;
            border-radius: 50px;
            font-weight: 600;
        }
        .order-card .footer .badge-estado.pending { background: rgba(245,158,11,0.15); color: var(--accent-gold); }
        .order-card .footer .badge-estado.cooking { background: rgba(59,130,246,0.15); color: var(--accent-blue); }

        .order-card .actions {
            display: flex;
            gap: 0.4rem;
            margin-top: 0.3rem;
            flex-wrap: wrap;
            width: 100%;
        }
        .order-card .actions .btn {
            padding: 0.5rem 0.8rem;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            flex: 1;
            min-width: 70px;
            text-align: center;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .order-card .actions .btn:hover { transform: scale(1.05); }
        .order-card .actions .btn-primary { background: var(--accent-gold); color: #0f172a; }
        .order-card .actions .btn-primary:hover { background: #d97706; }
        .order-card .actions .btn-success { background: var(--accent-green); color: white; }
        .order-card .actions .btn-success:hover { background: #059669; }
        .order-card .actions .btn-danger { background: var(--accent-red); color: white; }
        .order-card .actions .btn-danger:hover { background: #dc2626; }
        .order-card .actions .btn-secondary { background: var(--bg-secondary); color: var(--text-secondary); border: 1px solid var(--border-color); }
        .order-card .actions .btn-secondary:hover { background: var(--bg-card-hover); }

        .order-card .actions .btn .icon {
            font-size: 1.1rem;
            margin-right: 0.3rem;
        }
        
        /* ============================================
           VISTAS (Historial, Demoras, Ganancias)
           ============================================ */
        .view-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: var(--bg-secondary);
            border-radius: var(--radius);
            border: 1px solid var(--border-color);
            overflow: hidden;
            margin: 0.3rem 0;
        }
        .view-container .view-header {
            padding: 0.3rem 0.6rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid var(--border-color);
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 0.3rem;
            background: var(--bg-secondary);
        }
        .view-container .view-header .title {
            font-weight: 700;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }
        .view-container .view-header .filters {
            display: flex;
            gap: 0.3rem;
            flex-wrap: wrap;
            align-items: center;
        }
        .view-container .view-header .filters select,
        .view-container .view-header .filters button {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius-sm);
            padding: 0.1rem 0.4rem;
            color: var(--text-primary);
            font-size: 0.5rem;
            outline: none;
            cursor: pointer;
        }
        .view-container .view-header .filters select:focus,
        .view-container .view-header .filters button:hover {
            border-color: var(--accent-gold);
        }
        
        .view-container .view-content {
            flex: 1;
            overflow-y: auto;
            padding: 0.3rem 0.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
        }
        
        .view-container .view-content .empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            color: var(--text-muted);
            text-align: center;
        }
        .view-container .view-content .empty .icon { font-size: 2rem; margin-bottom: 0.3rem; }
        
        .ganancias-resumen {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.3rem;
            margin-bottom: 0.3rem;
        }
        .ganancias-resumen .resumen-card {
            background: var(--bg-card);
            border-radius: var(--radius-sm);
            padding: 0.4rem;
            text-align: center;
            border: 1px solid var(--border-color);
        }
        .ganancias-resumen .resumen-card .label {
            font-size: 0.5rem;
            color: var(--text-muted);
            text-transform: uppercase;
        }
        .ganancias-resumen .resumen-card .value {
            font-size: 1rem;
            font-weight: 900;
        }
        .ganancias-resumen .resumen-card .value.gold { color: var(--accent-gold); }
        .ganancias-resumen .resumen-card .value.green { color: var(--accent-green); }
        .ganancias-resumen .resumen-card .value.blue { color: var(--accent-blue); }
        .ganancias-resumen .resumen-card .value.purple { color: var(--accent-purple); }
        .ganancias-resumen .resumen-card .value.red { color: var(--accent-red); }
        
        .ganancias-detalle .detalle-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.2rem 0;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.6rem;
        }
        .ganancias-detalle .detalle-item .cliente-nombre {
            font-weight: 600;
            color: var(--text-primary);
        }
        .ganancias-detalle .detalle-item .pedido-total {
            font-weight: 700;
            color: var(--accent-gold);
        }
        .ganancias-detalle .detalle-item .pedido-fecha {
            font-size: 0.5rem;
            color: var(--text-muted);
        }
        
        /* ✅ NUEVO: Estilos para el cuadro de demoras y detalles */
        .ganancias-resumen-5 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.3rem;
            margin-bottom: 0.3rem;
        }
        .ganancias-resumen-5 .resumen-card {
            background: var(--bg-card);
            border-radius: var(--radius-sm);
            padding: 0.4rem;
            text-align: center;
            border: 1px solid var(--border-color);
        }
        .ganancias-resumen-5 .resumen-card .label {
            font-size: 0.5rem;
            color: var(--text-muted);
            text-transform: uppercase;
        }
        .ganancias-resumen-5 .resumen-card .value {
            font-size: 1rem;
            font-weight: 900;
        }
        .ganancias-resumen-5 .resumen-card .value.gold { color: var(--accent-gold); }
        .ganancias-resumen-5 .resumen-card .value.green { color: var(--accent-green); }
        .ganancias-resumen-5 .resumen-card .value.blue { color: var(--accent-blue); }
        .ganancias-resumen-5 .resumen-card .value.red { color: var(--accent-red); }
        .ganancias-resumen-5 .resumen-card .value.purple { color: var(--accent-purple); }
        .ganancias-resumen-5 .resumen-card.demora-card {
            border-color: var(--accent-red);
            background: rgba(239,68,68,0.08);
        }
        .ganancias-resumen-5 .resumen-card.liquidar-card {
            grid-column: span 2;
            background: linear-gradient(135deg, rgba(139,92,246,0.15), rgba(59,130,246,0.15));
            border-color: var(--accent-purple);
        }
        .ganancias-resumen-5 .resumen-card.liquidar-card .value {
            font-size: 1.5rem;
        }
        .ganancias-resumen-5 .resumen-card.liquidar-card .sub-label {
            font-size: 0.45rem;
            color: var(--text-muted);
            margin-top: 2px;
        }
        
        .ganancias-detalle-header {
            display: grid;
            grid-template-columns: 1.3fr 0.7fr 0.7fr 0.8fr 0.8fr;
            gap: 4px;
            padding: 4px 6px;
            font-size: 0.5rem;
            font-weight: 700;
            color: var(--text-secondary);
            background: var(--bg-card);
            border-radius: 6px;
            margin-bottom: 4px;
            text-transform: uppercase;
        }
        .ganancias-detalle-item {
            display: grid;
            grid-template-columns: 1.3fr 0.7fr 0.7fr 0.8fr 0.8fr;
            gap: 4px;
            padding: 5px 6px;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.55rem;
        }
        .ganancias-detalle-item.con-demora {
            background: rgba(239,68,68,0.05);
            border-left: 3px solid var(--accent-red);
            padding-left: 8px;
        }
        .ganancias-detalle-item .col-pedido {
            overflow: hidden;
        }
