        // 28.1 ENVIAR NOTIFICACIÓN CON CLOUD FUNCTION
        async function enviarNotificacionConCloudFunction(uidRepartidor, pedidoId, tipo = 'pedido') {
            try {
                const tokenSnap = await db.ref(`repartidores/${uidRepartidor}/token`).once('value');
                const token = tokenSnap.val();
                
                if (!token) {
                    console.warn('⚠️ Repartidor sin token FCM:', uidRepartidor);
                    return;
                }
                
                let datos = null;
                let titulo = '';
                let mensaje = '';
                
                if (tipo === 'pedido') {
                    const pedidoSnap = await db.ref(`pedidos/${pedidoId}`).once('value');
                    datos = pedidoSnap.val();
                    titulo = '🛵 Nuevo pedido disponible';
                    mensaje = `Recoge el pedido de ${datos?.cliente_nombre || 'cliente'} en ${datos?.restaurante_nombre || 'el restaurante'}`;
                } else {
                    const envioSnap = await db.ref(`envios/${pedidoId}`).once('value');
                    datos = envioSnap.val();
                    titulo = '📦 Nuevo reparto disponible';
                    mensaje = `Recoge el reparto de ${datos?.cliente_nombre || 'cliente'}${datos?.debe_cobrar ? ' - 💵 Cobrar en sitio' : ''}`;
                }
                
                if (!datos) {
                    console.warn('⚠️ Datos no encontrados:', pedidoId);
                    return;
                }
                
                console.log('📱 Token encontrado, enviando notificación...');
                
                const enviarNotificacion = functions.httpsCallable('enviarNotificationPedido');
                
                const result = await enviarNotificacion({
                    token: token,
                    titulo: titulo,
                    mensaje: mensaje,
                    data: { 
                        tipo: tipo, 
                        uid: uidRepartidor,
                        pedidoId: pedidoId
                    }
                });
                
                console.log('✅ Notificación push enviada:', result.data);
                return result.data;
                
            } catch (error) {
                console.error('❌ Error al enviar notificación:', error);
                throw error;
            }
        }

        // 28.2 NOTIFICAR REPARTIDOR
        window.notificarRepartidor = async function(pedidoId) {
            try {
                const pedidoSnap = await db.ref(`pedidos/${pedidoId}`).once('value');
                const pedido = pedidoSnap.val();
                
                if (!pedido) {
                    console.error('❌ Pedido no encontrado');
                    return;
                }

                const repartidoresSnap = await db.ref('repartidores')
                    .orderByChild('activo')
                    .equalTo(true)
                    .once('value');
                
                const repartidores = repartidoresSnap.val();
                if (!repartidores) {
                    console.warn('⚠️ No hay repartidores disponibles');
                    showToast('⚠️ No hay repartidores disponibles', 'warning');
                    return;
                }

                let repartidorId = null;
                let repartidorData = null;
                
                for (const [uid, data] of Object.entries(repartidores)) {
                    const pedidosActivosSnap = await db.ref('pedidos')
                        .orderByChild('uid_repartidor')
                        .equalTo(uid)
                        .once('value');
                    
                    const pedidosActivos = pedidosActivosSnap.val();
                    let tienePedidosActivos = false;
                    
                    if (pedidosActivos) {
                        for (const [pid, pData] of Object.entries(pedidosActivos)) {
                            const estado = pData.estado ? pData.estado.toLowerCase() : '';
                            if (estado === 'en_reparto' || estado === 'listo' || estado === 'reparto') {
                                tienePedidosActivos = true;
                                break;
                            }
                        }
                    }
                    
                    if (!tienePedidosActivos) {
                        repartidorId = uid;
                        repartidorData = data;
                        break;
                    }
                }
                
                if (!repartidorId) {
                    const keys = Object.keys(repartidores);
                    if (keys.length > 0) {
                        repartidorId = keys[0];
                        repartidorData = repartidores[keys[0]];
                        console.log('⚠️ Todos los repartidores están ocupados, asignando al primero:', repartidorId);
                    } else {
                        showToast('⚠️ No hay repartidores disponibles', 'warning');
                        return;
                    }
                }

                await db.ref(`pedidos/${pedidoId}/uid_repartidor`).set(repartidorId);
                await db.ref(`pedidos/${pedidoId}/repartidor_nombre`).set(repartidorData.nombre || 'Repartidor');
                await db.ref(`pedidos/${pedidoId}/timestamp_asignacion`).set(Date.now());
                // ❌ ELIMINADO: await db.ref(`pedidos/${pedidoId}/estado`).set('EN_REPARTO');
                await db.ref(`pedidos/${pedidoId}/historial`).push({
                    estado: 'coccion',
                    timestamp: Date.now(),
                    usuario: currentUser.uid,
                    accion: 'asignar_repartidor',
                    repartidor: repartidorId,
                    repartidor_nombre: repartidorData.nombre || 'Repartidor'
                });

                await enviarNotificacionConCloudFunction(repartidorId, pedidoId, 'pedido');

                showToast(`✅ Repartidor asignado: ${repartidorData.nombre || 'Repartidor'}`, 'success');
                renderizarVista();
                
            } catch (error) {
                console.error('❌ Error en notificarRepartidor:', error);
                showToast('❌ Error al asignar repartidor', 'error');
            }
        };

