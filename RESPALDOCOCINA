            function iniciarSonidoRepetido(pedidoId) {
                if (pedidoSonando === pedidoId || sonidoActivo) return;
                sonidoActivo = true;
                pedidoSonando = pedidoId;
                let repeticiones = 0;
                if (intervaloSonido) clearInterval(intervaloSonido);
                reproducirSonidoLlegada();
                intervaloSonido = setInterval(() => {
                    repeticiones++;
                    db.ref(`pedidos/${pedidoId}/estado`).once('value').then((snap) => {
                        const estado = snap.val() ? snap.val().toLowerCase() : '';
                        if (estado !== 'recibido' && estado !== 'pendiente') { detenerSonidoRepetido(); return; }
                    }).catch(() => {});
                    if (repeticiones >= 30) detenerSonidoRepetido();
                    else reproducirSonidoLlegada();
                }, 3000);
            }

            function detenerSonidoRepetido() {
                if (intervaloSonido) { clearInterval(intervaloSonido); intervaloSonido = null; }
                sonidoActivo = false;
                pedidoSonando = null;
            }

