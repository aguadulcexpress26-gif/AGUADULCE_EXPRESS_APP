                        async function calcularCostoEnvio(direccion) {
                            if (!direccion || direccion.trim().length < 5) {
                                costoDisplay.textContent = '📍 Escribe dirección';
                                costoDisplay.style.color = '#94a3b8';
                                calculator.style.borderColor = '#334155';
