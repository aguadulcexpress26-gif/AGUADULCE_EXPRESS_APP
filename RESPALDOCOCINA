            // ============================================
            // 17. VERIFICAR ESTADO DEL RESTAURANTE
            // ============================================
            async function verificarEstadoRestaurante() {
                try {
                    const snapshot = await db.ref(`restaurantes/${restauranteId}`).once('value');
                    const data = snapshot.val();
                    
                    if (!data) {
                        return { abierto: false, motivo: 'Restaurante no encontrado', horario: '' };
                    }
                    
                    if (data.activo === false) {
                        return { abierto: false, motivo: '🚫 Desactivado', horario: '' };
                    }
                    
                    if (data.pausado === true) {
                        return { abierto: false, motivo: '⏸️ En pausa', horario: '' };
                    }
                    
                    const horarios = data.horarios_dias;
                    if (!horarios) {
                        return { abierto: false, motivo: '📅 Sin horarios', horario: '' };
                    }
                    
                    const ahora = new Date();
                    const diasSemana = ['DOMINGO', 'LUNES', 'MARTES', 'MIERCOLES', 'JUEVES', 'VIERNES', 'SABADO'];
                    const hoy = diasSemana[ahora.getDay()];
                    const horarioHoy = horarios[hoy];
                    
                    if (!horarioHoy || horarioHoy.dia_libre === true || horarioHoy.activo === false) {
                        return { abierto: false, motivo: '📅 Cerrado hoy', horario: '' };
                    }
                    
                    const horaActual = ahora.getHours() + ahora.getMinutes() / 60;
                    
                    function conv(h) {
                        if (!h || h === 'CERRADO') return null;
                        const [hh, mm] = h.split(':');
                        return parseInt(hh) + parseInt(mm) / 60;
                    }
                    
                    const a1 = conv(horarioHoy.apertura1);
                    const c1 = conv(horarioHoy.cierre1);
                    const a2 = conv(horarioHoy.apertura2);
                    const c2 = conv(horarioHoy.cierre2);
                    
                    let abierto = false;
                    let horarioTexto = '';
                    
                    if (a1 !== null && c1 !== null) {
                        if (horaActual >= a1 && horaActual < c1) abierto = true;
                        horarioTexto = `${horarioHoy.apertura1}-${horarioHoy.cierre1}`;
                    }
                    
                    if (a2 !== null && c2 !== null) {
                        if (horaActual >= a2 && horaActual < c2) abierto = true;
                        if (horarioTexto) horarioTexto += ` / `;
                        horarioTexto += `${horarioHoy.apertura2}-${horarioHoy.cierre2}`;
                    }
                    
                    if (!horarioTexto) {
                        return { abierto: false, motivo: '📅 Sin horario', horario: '' };
                    }
                    
                    return {
                        abierto: abierto,
                        motivo: abierto ? `✅ Abierto` : `🔴 Cerrado`,
                        horario: horarioTexto
                    };
                    
                } catch (error) {
                    console.error('❌ Error verificando estado:', error);
                    return { abierto: false, motivo: '❌ Error', horario: '' };
                }
            }

