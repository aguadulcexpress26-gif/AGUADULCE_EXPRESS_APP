window.imprimirComandaConImpresora = function(pedidoId) {
    if (!impresoraConfigurada) {
        Swal.fire({
            title: '⚠️ Sin impresora',
            text: 'No hay una impresora configurada. ¿Quieres configurar una ahora?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: '✅ Configurar',
            cancelButtonText: 'Cancelar',
            background: '#0f172a',
            color: 'white',
            confirmButtonColor: '#f59e0b'
        }).then((result) => {
            if (result.isConfirmed) {
                window.configurarImpresora();
            }
        });
        return;
    }

    if (!navigator.bluetooth) {
        Swal.fire({
            title: '❌ No soportado',
            text: 'Este navegador no soporta Bluetooth. Usa Chrome en Android.',
            icon: 'error',
            background: '#0f172a',
            color: 'white',
            confirmButtonColor: '#f59e0b'
        });
        return;
    }

    Promise.all([
        db.ref(`pedidos/${pedidoId}`).once('value'),
        db.ref(`restaurantes/${restauranteId}`).once('value')
    ]).then(async ([pedidoSnap, restauranteSnap]) => {
        const data = pedidoSnap.val();
        const restaurante = restauranteSnap.val();

        if (!data) {
            showToast('❌ Pedido no encontrado', 'error');
            return;
        }

        const nombreRestaurante = restaurante?.NOMBRE_RESTAURANTE || restaurante?.nombre || 'Restaurante';
        const texto = generarTextoComanda(data, nombreRestaurante, pedidoId);

        try {
            let connection = impresoraConectada;

            if (!connection || !connection.characteristic) {
                connection = await conectarImpresoraGuardada();
            }

            if (!connection) {
                throw new Error('No se pudo conectar a la impresora');
            }

            const encoder = new TextEncoder('utf-8');
            const dataBytes = encoder.encode(texto);

            const chunkSize = 20;
            for (let i = 0; i < dataBytes.length; i += chunkSize) {
                const chunk = dataBytes.slice(i, i + chunkSize);
                await connection.characteristic.writeValue(chunk);
                await new Promise(resolve => setTimeout(resolve, 50));
            }

            showToast(`🖨️ Ticket enviado a ${connection.device.name}`, 'success');
            actualizarIconoImpresora();

        } catch (bluetoothError) {
            console.warn('⚠️ Error en Bluetooth:', bluetoothError);

            const estadoEl = document.getElementById('estado-impresora');
            if (estadoEl) {
                estadoEl.textContent = '🟡';
                estadoEl.title = `Reconectando...`;
            }

            try {
                impresoraConectada = null;
                impresoraCharacteristic = null;
                const newConnection = await conectarImpresoraGuardada();

                if (newConnection) {
                    const encoder = new TextEncoder('utf-8');
                    const dataBytes = encoder.encode(texto);

                    const chunkSize = 20;
                    for (let i = 0; i < dataBytes.length; i += chunkSize) {
                        const chunk = dataBytes.slice(i, i + chunkSize);
                        await newConnection.characteristic.writeValue(chunk);
                        await new Promise(resolve => setTimeout(resolve, 50));
                    }

                    showToast('🖨️ Ticket enviado (reconexión exitosa)', 'success');
                    actualizarIconoImpresora();
                    return;
                }
            } catch (retryError) {
                console.error('❌ Error en reconexión:', retryError);
            }

            const textoPreview = texto
                .replace(/\x1B/g, '').replace(/\x40/g, '')
                .replace(/\x61/g, '').replace(/\x45/g, '')
                .replace(/\x69/g, '').replace(/\x21/g, '')
                .replace(/\x10/g, '').replace(/\x00/g, '');

            Swal.fire({
                title: '🧾 Ticket de Cocina',
                html: `
                    <div style="text-align:left;color:white;background:#0f172a;border-radius:12px;padding:16px;font-family:'Courier New',monospace;font-size:12px;max-height:400px;overflow-y:auto;white-space:pre-wrap;border:1px solid #2a3a5a;">
${textoPreview}
                    </div>
                    <div style="margin-top:12px;font-size:12px;color:#94a3b8;text-align:center;">
                        ⚠️ No se pudo conectar con la impresora.<br>
                        Impresora: <strong style="color:#f59e0b;">${nombreImpresora}</strong>
                    </div>
                `,
                confirmButtonText: '📄 Vista previa',
                showCancelButton: true,
                cancelButtonText: 'Cancelar',
                background: '#0f172a',
                color: 'white',
                confirmButtonColor: '#f59e0b',
                cancelButtonColor: '#334155',
                width: '92%'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.imprimirComanda(pedidoId);
                }
            });
        }

    }).catch((error) => {
        console.error('Error al obtener datos:', error);
        showToast('❌ Error al imprimir', 'error');
    });
};

