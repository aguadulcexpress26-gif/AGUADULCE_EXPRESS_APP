                        <div style="text-align:center;font-size:0.5rem;color:var(--text-muted);margin-bottom:0.3rem;">
                            ⚙️ Comisión: ${comisionTipo === 'porcentaje' ? comisionPorcentaje + '%' : comisionPorcentaje + '€ fijo'}
                            · 💰 Costo demora: ${costoDemora.toFixed(2)}€/min
                            · 📦 ${totalRepartos} reparto${totalRepartos !== 1 ? 's' : ''} personal${totalRepartos !== 1 ? 'es' : ''}
                        </div>
                    `;
                    
                    if (pedidosDetalle.length === 0) {
                        html += `<div class="empty"><div class="icon">📭</div><div>No hay pedidos en este período</div></div>`;
                    } else {
