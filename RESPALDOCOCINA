function parsearOpcionesDetalle(raw) {
    if (!raw) return [];
    const out = [];
    const entries = Array.isArray(raw) ? raw : Object.values(raw);
    for (const item of entries) {
        if (!item || !item.grupo) continue;
        let valores = [];
        if (Array.isArray(item.valores)) {
            valores = item.valores.filter(v => v);
        } else if (item.valores && typeof item.valores === 'object') {
            valores = Object.values(item.valores).filter(v => v);
        } else if (typeof item.valores === 'string') {
            valores = [item.valores];
        }
        if (valores.length === 0) continue;
        out.push({ grupo: item.grupo, valores });
    }
    return out;
}

function parsearOpcionesString(opcionesStr) {
    if (!opcionesStr || typeof opcionesStr !== 'string') return [];
    const etiquetas = ['Acompañantes', 'Bebidas', 'Tamaño', 'Extras'];
    const grupos = opcionesStr.split('|').map(s => s.trim()).filter(Boolean);
    return grupos.map((valores, idx) => ({
        grupo: etiquetas[idx] || `Opción ${idx + 1}`,
        valores: valores.split(',').map(v => v.trim()).filter(Boolean)
    }));
}

function obtenerOpcionesItem(item) {
    if (item.opciones_detalle) {
        const det = parsearOpcionesDetalle(item.opciones_detalle);
        if (det.length > 0) return det;
    }
    return parsearOpcionesString(item.opciones);
}

function formatearItemTexto(item, conTildes = true) {
    const lineas = [];
    const cant = item.cantidad || 1;
    lineas.push(`${cant}x ${item.nombre || 'Producto'}`);

    // Opciones elegidas por el cliente (con " + " como viñeta)
    const opciones = obtenerOpcionesItem(item);
    for (const op of opciones) {
        lineas.push(`  + ${op.grupo}: ${op.valores.join(', ')}`);
    }

    // Base del plato (siempre visible)
    const base = item.precio_unitario || 0;
    lineas.push(`  Base: ${base.toFixed(2)} EUR`);

    // Extras y Subtotal (solo si tiene extras)
    const extras = item.extras_precio || 0;
    if (extras > 0) {
        const subtotal = base + extras;
        lineas.push(`  Extras: ${extras.toFixed(2)} EUR`);
        lineas.push(`  Subtotal: ${subtotal.toFixed(2)} EUR`);
    }

    // Nota del cliente (sin emoji)
    if (item.nota_cliente && item.nota_cliente.trim()) {
        lineas.push(`  Nota: ${item.nota_cliente.trim()}`);
    }

    let texto = lineas.join('\n');
    if (!conTildes) texto = quitarTildes(texto);
    return texto;
}
function quitarTildes(txt) {
    if (!txt) return '';
    return txt
        .replace(/á/g, 'a').replace(/é/g, 'e').replace(/í/g, 'i')
        .replace(/ó/g, 'o').replace(/ú/g, 'u').replace(/Á/g, 'A')
        .replace(/É/g, 'E').replace(/Í/g, 'I').replace(/Ó/g, 'O')
        .replace(/Ú/g, 'U').replace(/ñ/g, 'n').replace(/Ñ/g, 'N')
        .replace(/ü/g, 'u').replace(/Ü/g, 'U')
        .replace(/•/g, '+');
}

function envolverTexto(texto, ancho) {
    if (!texto) return [''];
    const palabras = texto.split(' ');
    const lineas = [];
    let actual = '';
    for (const palabra of palabras) {
        if ((actual + ' ' + palabra).trim().length > ancho) {
            if (actual) lineas.push(actual.trim());
            actual = palabra;
        } else {
            actual = (actual + ' ' + palabra).trim();
        }
    }
    if (actual) lineas.push(actual.trim());
    return lineas.length ? lineas : [''];
}

