    <!-- ============================================
    JAVASCRIPT PRINCIPAL
    ============================================ -->
    <script>
        // ============================================
        // 1. CONFIGURACIÓN DE FIREBASE
        // ============================================
        const firebaseConfig = {
            apiKey: "AIzaSyBEapmpody3y_vFyPF0ngUnCn5ZFOtxPjs",
            authDomain: "aguadulce-express-v2.firebaseapp.com",
            databaseURL: "https://aguadulce-express-v2-default-rtdb.firebaseio.com",
            projectId: "aguadulce-express-v2",
            storageBucket: "aguadulce-express-v2.appspot.com",
            messagingSenderId: "103953800507",
            appId: "1:103953800507:web:tu_app_id"
        };

        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const db = firebase.database();
        const functions = firebase.functions();

        // ============================================
        // 2. VARIABLES GLOBALES
        // ============================================
        let currentUser = null;
        let currentView = 'activos';
        let pedidosListeners = [];
        let enviosListeners = [];
        let restauranteId = null;
        let estaPausado = false;
        let sonidoActivo = false;
        let intervaloSonido = null;
        let pedidoSonando = null;
        const TIEMPO_ELABORACION_DEFAULT = 20;
        let tiempoElaboracionRestaurante = TIEMPO_ELABORACION_DEFAULT;

        // ============================================
        // 3. DETECCIÓN DE ORIENTACIÓN
        // ============================================
        function detectarOrientacion() {
            const esTableta = window.innerWidth >= 768 && window.innerWidth <= 1024;
            const esVertical = window.innerHeight > window.innerWidth;
            const overlay = document.getElementById('orientacion-overlay');
            
            if (esTableta && esVertical) {
                overlay.classList.remove('hidden');
            } else {
                overlay.classList.add('hidden');
            }
        }

        function ocultarOverlayOrientacion() {
            document.getElementById('orientacion-overlay').classList.add('hidden');
        }

        window.addEventListener('resize', detectarOrientacion);
        window.addEventListener('orientationchange', () => setTimeout(detectarOrientacion, 300));
        document.addEventListener('DOMContentLoaded', detectarOrientacion);

        // ============================================
        // 4. PWA - INSTALACIÓN
        // ============================================
        let deferredPrompt = null;
        let installBtn = document.getElementById('install-btn');

        if (window.matchMedia('(display-mode: standalone)').matches) {
            console.log('✅ App ya está instalada');
            if (installBtn) installBtn.style.display = 'none';
        }

        window.addEventListener('beforeinstallprompt', (e) => {
            console.log('📱 beforeinstallprompt detectado');
            e.preventDefault();
            deferredPrompt = e;
            if (installBtn) {
                installBtn.style.display = 'flex';
                installBtn.textContent = '📱 Instalar App';
                console.log('✅ Botón de instalación visible');
            }
        });

        window.addEventListener('appinstalled', () => {
            console.log('🎉 App instalada correctamente');
            deferredPrompt = null;
            if (installBtn) installBtn.style.display = 'none';
            showToast('🎉 App instalada correctamente', 'success');
        });

        if (installBtn) {
            installBtn.addEventListener('click', async () => {
                console.log('📱 Click en botón de instalación');
                if (!deferredPrompt) {
                    console.log('⚠️ deferredPrompt es null');
                    showToast('⚠️ Usa el menú de Chrome (⋮) → Instalar aplicación', 'warning');
                    return;
                }
                try {
                    deferredPrompt.prompt();
                    const result = await deferredPrompt.userChoice;
                    if (result.outcome === 'accepted') {
                        console.log('✅ Instalación aceptada');
                        showToast('✅ App instalada con éxito', 'success');
                    } else {
                        console.log('❌ Instalación rechazada');
                        showToast('❌ Instalación cancelada', 'error');
                    }
                    deferredPrompt = null;
                } catch (error) {
                    console.error('❌ Error:', error);
                    showToast('❌ Error al instalar', 'error');
                }
            });
        }

        setTimeout(() => {
            if (!deferredPrompt && installBtn && !window.matchMedia('(display-mode: standalone)').matches) {
                console.log('⏰ No se detectó beforeinstallprompt - usa el menú de Chrome');
                installBtn.textContent = '📱 Instalar (menú Chrome ⋮)';
            }
        }, 3000);

        // ============================================
        // 5. TOAST NOTIFICATIONS
        // ============================================
        function showToast(message, type = 'info') {
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            toast.textContent = message;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(20px)';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // ============================================
        // 6. MENÚ HAMBURGUESA
        // ============================================
        const menuToggle = document.getElementById('menu-toggle');
        const menuDesplegable = document.getElementById('menu-desplegable');

        if (menuToggle) {
            menuToggle.addEventListener('click', (e) => {
                e.stopPropagation();
                menuDesplegable.classList.toggle('open');
                menuToggle.classList.toggle('active');
                menuToggle.textContent = menuDesplegable.classList.contains('open') ? '✕' : '☰';
            });

            document.addEventListener('click', (e) => {
                if (!menuDesplegable.contains(e.target) && e.target !== menuToggle) {
                    menuDesplegable.classList.remove('open');
                    menuToggle.classList.remove('active');
                    menuToggle.textContent = '☰';
                }
            });
        }

        // ============================================
        // 7. MENÚ - CAMBIO DE VISTA
        // ============================================
        document.querySelectorAll('.menu-item[data-view]').forEach(item => {
            item.addEventListener('click', () => {
                document.querySelectorAll('.menu-item[data-view]').forEach(el => {
                    el.classList.remove('active');
                });
                item.classList.add('active');
                
                currentView = item.dataset.view;
                
                if (currentView === 'activos') {
                    restaurarVistaColumnas();
                }
                
                renderizarVista();
                
                menuDesplegable.classList.remove('open');
                menuToggle.classList.remove('active');
                menuToggle.textContent = '☰';
            });
        });

        // ============================================
        // 8. AUTENTICACIÓN
        // ============================================
        const loginForm = document.getElementById('login-form');
        const loginEmail = document.getElementById('login-email');
        const loginPassword = document.getElementById('login-password');
        const loginBtn = document.getElementById('login-btn');
        const loginText = document.getElementById('login-text');
        const loginLoading = document.getElementById('login-loading');
        const loginError = document.getElementById('login-error');

        loginForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const email = loginEmail.value.trim();
            const password = loginPassword.value;
            
            if (!email || !password) {
                loginError.textContent = 'Por favor, completa todos los campos';
                loginError.classList.remove('hidden');
                return;
            }
            
            loginBtn.disabled = true;
            loginText.classList.add('hidden');
            loginLoading.classList.remove('hidden');
            loginError.classList.add('hidden');
            
            try {
                const credenciales = await auth.signInWithEmailAndPassword(email, password);
                const user = credenciales.user;
                
                const snapshot = await db.ref(`restaurantes/${user.uid}`).once('value');
                if (!snapshot.exists()) {
                    await auth.signOut();
                    throw new Error('Esta cuenta no es un restaurante válido');
                }
                
                showToast('✅ Bienvenido al panel de cocina', 'success');
                
            } catch (error) {
                console.error('Error de login:', error);
                loginError.textContent = error.message;
                loginError.classList.remove('hidden');
                
                loginBtn.disabled = false;
                loginText.classList.remove('hidden');
                loginLoading.classList.add('hidden');
            }
        });

        // ============================================
        // 9. ESTADO DE AUTENTICACIÓN
        // ============================================
        auth.onAuthStateChanged(async (user) => {
            const app = document.getElementById('app');
            const loginContainer = document.getElementById('login-container');
            
            if (user) {
                console.log('✅ Usuario autenticado:', user.uid);
                currentUser = user;
                restauranteId = user.uid;
                
                loginContainer.classList.add('hidden');
                app.classList.remove('hidden');
                
                await cargarDatosRestaurante();
                await cargarEstadoPausa();
                await cargarTiempoElaboracion();
                escucharPedidos();
                escucharEnvios();
                
                setTimeout(() => {
                    renderizarVista();
                }, 500);
                
                setTimeout(solicitarPermisoNotificaciones, 3000);
                
            } else {
                console.log('❌ Sin usuario autenticado');
                app.classList.add('hidden');
                loginContainer.classList.remove('hidden');
                
                pedidosListeners.forEach(ref => ref.off());
                pedidosListeners = [];
                enviosListeners.forEach(ref => ref.off());
                enviosListeners = [];
            }
        });

        // ============================================
        // 10. CERRAR SESIÓN
        // ============================================
        document.getElementById('btn-cerrar-sesion').addEventListener('click', async () => {
            if (confirm('¿Seguro que quieres cerrar sesión?')) {
                await auth.signOut();
                showToast('👋 Sesión cerrada', 'info');
            }
        });

        // ============================================
        // 11. CARGAR DATOS DEL RESTAURANTE
        // ============================================
        async function cargarDatosRestaurante() {
            try {
                const snapshot = await db.ref(`restaurantes/${restauranteId}`).once('value');
                const data = snapshot.val();
                
                if (data) {
                    const nombre = data.NOMBRE_RESTAURANTE || data.nombre || 'Restaurante';
                    const email = data.email || '';
                    
                    document.getElementById('restaurante-nombre').textContent = nombre;
                    document.getElementById('restaurante-email').textContent = email;
                    document.getElementById('header-restaurante').textContent = nombre;
                    document.getElementById('header-email').textContent = email;
                }
            } catch (error) {
                console.error('Error al cargar restaurante:', error);
            }
        }

        // ============================================
        // 12. CARGAR TIEMPO DE ELABORACIÓN
        // ============================================
        async function cargarTiempoElaboracion() {
            try {
                const snapshot = await db.ref(`restaurantes/${restauranteId}/tiempo_elaboracion`).once('value');
                const valor = snapshot.val();
                if (valor) {
                    tiempoElaboracionRestaurante = valor;
                    console.log(`⏱️ Tiempo de elaboración: ${tiempoElaboracionRestaurante} minutos`);
                } else {
                    tiempoElaboracionRestaurante = TIEMPO_ELABORACION_DEFAULT;
                    console.log(`⏱️ Usando tiempo por defecto: ${tiempoElaboracionRestaurante} minutos`);
                }
            } catch (error) {
                console.error('Error al cargar tiempo de elaboración:', error);
                tiempoElaboracionRestaurante = TIEMPO_ELABORACION_DEFAULT;
            }
        }

        // ============================================
        // 13. ESTADO DE PAUSA
        // ============================================
        async function cargarEstadoPausa() {
            try {
                const snapshot = await db.ref(`restaurantes/${restauranteId}/pausado`).once('value');
                estaPausado = snapshot.val() === true;
                actualizarUIEstadoPausa();
            } catch (error) {
                console.error('Error al cargar estado de pausa:', error);
            }
        }

        function actualizarUIEstadoPausa() {
            const banner = document.getElementById('pausa-banner');
            const btnPausa = document.getElementById('btn-pausa');
            const btnPausaHeader = document.getElementById('btn-pausa-header');
            const icono = document.getElementById('icono-pausa');
            const texto = document.getElementById('texto-pausa');
            const estadoMenu = document.getElementById('estado-pausa-menu');

            if (estaPausado) {
                banner.classList.add('active');
                if (btnPausa) { btnPausa.classList.add('active'); btnPausa.classList.remove('inactive'); }
                if (btnPausaHeader) { btnPausaHeader.classList.add('activo'); btnPausaHeader.classList.remove('inactivo'); btnPausaHeader.textContent = '▶️ Reanudar'; }
                if (icono) icono.textContent = '▶️';
                if (texto) texto.textContent = 'Reanudar Pedidos';
                if (estadoMenu) estadoMenu.textContent = '⏸️ PAUSADO';
            } else {
                banner.classList.remove('active');
                if (btnPausa) { btnPausa.classList.remove('active'); btnPausa.classList.add('inactive'); }
                if (btnPausaHeader) { btnPausaHeader.classList.remove('activo'); btnPausaHeader.classList.add('inactivo'); btnPausaHeader.textContent = '⏸️ Pausar'; }
                if (icono) icono.textContent = '⏸️';
                if (texto) texto.textContent = 'Pausar Pedidos';
                if (estadoMenu) estadoMenu.textContent = '● Activo';
            }
        }

        async function togglePausa() {
            try {
                const nuevoEstado = !estaPausado;
                await db.ref(`restaurantes/${restauranteId}/pausado`).set(nuevoEstado);
                estaPausado = nuevoEstado;
                actualizarUIEstadoPausa();
                
                if (nuevoEstado) {
                    showToast('⏸️ Restaurante en PAUSA', 'warning');
                } else {
                    showToast('▶️ Restaurante ACTIVO', 'success');
                }
            } catch (error) {
                console.error('Error al cambiar estado de pausa:', error);
                showToast('❌ Error al cambiar estado de pausa', 'error');
            }
        }

        // ============================================
        // 14. ESCUCHAR PEDIDOS CON SONIDO REPETIDO
        // ============================================
        let pedidosAnteriores = {};

        function escucharPedidos() {
            pedidosListeners.forEach(ref => ref.off());
            pedidosListeners = [];
            
            const pedidosRef = db.ref('pedidos');
            
            pedidosRef.on('value', (snapshot) => {
                const pedidos = snapshot.val() || {};
                const pedidosActuales = {};
                
                for (const [id, data] of Object.entries(pedidos)) {
                    pedidosActuales[id] = data;
                }
                
                const nuevosPedidos = [];
                for (const [id, data] of Object.entries(pedidosActuales)) {
                    if (!pedidosAnteriores[id]) {
                        const restId = data.restauranteId || data.restaurante_id || data.uid_restaurante;
                        if (restId === restauranteId) {
                            nuevosPedidos.push({ id, ...data });
                        }
                    }
                }
                
                if (nuevosPedidos.length > 0) {
                    console.log(`🔔 ${nuevosPedidos.length} nuevo(s) pedido(s) recibido(s)`);
                    
                    for (const pedido of nuevosPedidos) {
                        const cliente = pedido.cliente_nombre || pedido.clienteNombre || 'Cliente';
                        showToast(`📦 Nuevo pedido de ${cliente}`, 'info');
                        
                        // INICIAR SONIDO REPETIDO PARA PEDIDOS EN ESTADO RECIBIDO
                        const estado = pedido.estado ? pedido.estado.toLowerCase() : '';
                        if (estado === 'recibido' || estado === 'pendiente') {
                            if (!sonidoActivo) {
                                iniciarSonidoRepetido(pedido.id);
                            }
                        }
                    }
                }
                
                pedidosAnteriores = pedidosActuales;
                renderizarVista();
            });
            
            pedidosListeners.push(pedidosRef);
            console.log('✅ Listener de pedidos activado con sonido repetido');
        }

        // ============================================
        // 15. ESCUCHAR ENVÍOS
        // ============================================
        function escucharEnvios() {
            enviosListeners.forEach(ref => ref.off());
            enviosListeners = [];
            
            const enviosRef = db.ref('envios');
            
            enviosRef.on('value', (snapshot) => {
                const envios = snapshot.val() || {};
                let countEnvios = 0;
                
                for (const [id, data] of Object.entries(envios)) {
                    const restId = data.uid_restaurante;
                    if (restId === restauranteId) {
                        const estado = data.estado || '';
                        if (estado !== 'entregado') {
                            countEnvios++;
                        }
                    }
                }
                
                document.getElementById('count-envios').textContent = countEnvios;
                document.getElementById('contador-envios').textContent = countEnvios;
                renderizarVista();
            });
            
            enviosListeners.push(enviosRef);
            console.log('✅ Listener de envíos activado');
        }

        // ============================================
        // 16. REPRODUCIR SONIDO
        // ============================================
        function reproducirSonidoLlegada() {
            try {
                const audio = document.getElementById('audio-llegada');
                if (audio) {
                    audio.currentTime = 0;
                    audio.volume = 0.9;
                    audio.play().catch(e => console.log('⚠️ Sonido bloqueado por el navegador'));
                } else {
                    const nuevoAudio = new Audio('https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3');
                    nuevoAudio.volume = 0.9;
                    nuevoAudio.play().catch(e => console.log('⚠️ Sonido bloqueado por el navegador'));
                }
                
                if (navigator.vibrate) {
                    navigator.vibrate([200, 100, 200]);
                }
            } catch (error) {
                console.log('⚠️ Error al reproducir sonido:', error);
            }
        }

        // ============================================
        // 17. SONIDO REPETIDO HASTA ACEPTAR/RECHAZAR
        // ============================================
        function iniciarSonidoRepetido(pedidoId) {
            if (pedidoSonando === pedidoId) return;
            if (sonidoActivo) detenerSonidoRepetido();
            
            sonidoActivo = true;
            pedidoSonando = pedidoId;
            let repeticiones = 0;
            const MAX_REPETICIONES = 30;
            
            if (intervaloSonido) {
                clearInterval(intervaloSonido);
                intervaloSonido = null;
            }
            
            reproducirSonidoLlegada();
            
            intervaloSonido = setInterval(() => {
                repeticiones++;
                
                db.ref(`pedidos/${pedidoId}/estado`).once('value').then((snap) => {
                    const estado = snap.val();
                    const estadoLower = estado ? estado.toLowerCase() : '';
                    if (estadoLower !== 'recibido' && estadoLower !== 'pendiente') {
                        console.log('🔇 Pedido aceptado/rechazado, deteniendo sonido');
                        detenerSonidoRepetido();
                        return;
                    }
                }).catch(error => {
                    console.error('Error al verificar estado del pedido:', error);
                });
                
                if (repeticiones >= MAX_REPETICIONES) {
                    console.log('⏰ Límite de repeticiones alcanzado, deteniendo sonido');
                    detenerSonidoRepetido();
                } else {
                    reproducirSonidoLlegada();
                }
            }, 3000);
        }

        function detenerSonidoRepetido() {
            if (intervaloSonido) {
                clearInterval(intervaloSonido);
                intervaloSonido = null;
            }
            sonidoActivo = false;
            pedidoSonando = null;
        }

