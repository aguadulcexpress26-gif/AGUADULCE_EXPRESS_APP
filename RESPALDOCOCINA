// CARGAR PEDIDOS ACTIVOS (NUEVA FUNCIÓN)
// ============================================
function cargarPedidosActivos() {
    console.log('📌 cargarPedidosActivos() ejecutada');
    
    const colPendiente = document.getElementById('col-pendiente');
    const colCoccion = document.getElementById('col-coccion');
    const colListo = document.getElementById('col-listo');
    
    if (colPendiente) colPendiente.innerHTML = '';
    if (colCoccion) colCoccion.innerHTML = '';
    if (colListo) colListo.innerHTML = '';
    
    db.ref('pedidos').once('value')
        .then((snapshot) => {
            const pedidos = snapshot.val();
            
            let countPendiente = 0, countCoccion = 0, countListo = 0;
            
            if (!pedidos) {
                mostrarMensajeVacio('col-pendiente', '📥', 'No hay pedidos en entrada');
                mostrarMensajeVacio('col-coccion', '👨‍🍳', 'No hay pedidos en proceso');
                mostrarMensajeVacio('col-listo', '✅', 'No hay pedidos listos');
                actualizarContadores(0, 0, 0);
                return;
            }
            
            const pedidosArray = Object.entries(pedidos);
            
            for (const [id, data] of pedidosArray) {
                const restId = data.restauranteId || data.restaurante_id || data.uid_restaurante;
                if (restId !== restauranteId) continue;
                
                let estado = data.estado ? data.estado.toLowerCase() : '';
                if (estado === 'recibido') estado = 'pendiente';
                
                if (estado === 'pendiente') {
                    countPendiente++;
                    agregarPedidoAColumna(id, { ...data, estado: estado });
                } else if (estado === 'coccion') {
                    countCoccion++;
                    agregarPedidoAColumna(id, { ...data, estado: estado });
                } else if (estado === 'listo' || estado === 'en_reparto') {
                    countListo++;
                    agregarPedidoAColumna(id, { ...data, estado: estado });
                }
            }
            
            if (countPendiente === 0) {
                mostrarMensajeVacio('col-pendiente', '📥', 'No hay pedidos en entrada');
            }
            if (countCoccion === 0) {
                mostrarMensajeVacio('col-coccion', '👨‍🍳', 'No hay pedidos en proceso');
            }
            if (countListo === 0) {
                mostrarMensajeVacio('col-listo', '✅', 'No hay pedidos listos');
            }
            
            actualizarContadores(countPendiente, countCoccion, countListo);
            
        })
        .catch((error) => {
            console.error('Error al cargar pedidos:', error);
        });
}

