                            if (esReparto) {
                                // Reparto personal: NO suma a la base.
                                // Su monto se acumula APARTE y se RESTA al final.
                                const montoReparto = parseFloat(data.envio || data.monto_reparto || data.total || 0);
                                
                                totalRepartos++;
                                totalRepartosMonto += montoReparto;
                                
