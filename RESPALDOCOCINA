        function agregarPedidoAColumna(id, data) {
            let estado = data.estado || 'pendiente';
            estado = estado.toLowerCase();
            if (estado === 'recibido') estado = 'pendiente';
            
            let columnaId = '';
            let contadorRef = '';
            
            switch(estado) {
                case 'pendiente':
                    columnaId = 'col-pendiente';
                    contadorRef = 'count-pendiente';
                    break;
                case 'coccion':
                    columnaId = 'col-coccion';
                    contadorRef = 'count-coccion';
                    break;
                case 'listo':
                case 'en_reparto':
                    columnaId = 'col-listo';
                    contadorRef = 'count-listo';
                    break;
                default:
                    columnaId = 'col-pendiente';
                    contadorRef = 'count-pendiente';
            }
            
            const container = document.getElementById(columnaId);
            if (!container) return;
            
            const contador = document.getElementById(contadorRef);
            if (contador) {
                contador.textContent = parseInt(contador.textContent) + 1;
            }
            
            const clienteNombre = data.cliente_nombre || data.clienteNombre || 'Cliente';
            const telefono = data.cliente_telefono || data.telefono || 'Sin teléfono';
            const direccion = data.direccion || 'Sin dirección';
            const idPedido = data.id_pedido || data.id || id.substring(0, 8);
            const total = data.total || 0;
            const timestamp = data.timestamp ? new Date(data.timestamp).toLocaleTimeString() : '';
            
            // CALCULAR TIEMPO DE ELABORACIÓN
            const tiempoInicio = data.timestamp_inicio || data.timestamp || Date.now();
            const tiempoActual = Date.now();
            const tiempoTranscurrido = Math.floor((tiempoActual - tiempoInicio) / 60000);
            const tiempoLimite = data.tiempo_limite || tiempoElaboracionRestaurante || TIEMPO_ELABORACION_DEFAULT;
            const tiempoRestante = Math.max(0, tiempoLimite - tiempoTranscurrido);
            const enDemora = tiempoTranscurrido > tiempoLimite;
            
            let tiempoDisplay = '';
            let badgeDemora = '';
            let sonidoAlerta = false;
            
            if (estado === 'pendiente') {
                tiempoDisplay = '⏳ Esperando';
            } else if (estado === 'coccion') {
                if (enDemora) {
                    tiempoDisplay = `⏱️ ${tiempoTranscurrido} min (DEMORA)`;
                    badgeDemora = `<span style="background:#ef4444;color:white;padding:2px 10px;border-radius:9999px;font-size:10px;font-weight:700;animation:pulse-badge 1s ease-in-out infinite;">🔴 DEMORA</span>`;
                    
                    if (!data._alerta_sonada) {
                        data._alerta_sonada = true;
                        sonidoAlerta = true;
                        db.ref(`pedidos/${id}/_alerta_sonada`).set(true);
                    }
                } else {
                    tiempoDisplay = `⏱️ ${tiempoTranscurrido} min (${tiempoRestante} min restante)`;
                }
            } else if (estado === 'listo' || estado === 'en_reparto') {
                const tiempoListo = data.timestamp_listo || Date.now();
                const tiempoEspera = Math.floor((tiempoActual - tiempoListo) / 60000);
                tiempoDisplay = `✅ Listo (${tiempoEspera} min espera)`;
            }
            
            // Productos
            let productosHtml = '';
            if (data.items && data.items.length > 0) {
                productosHtml = data.items.map(item => 
                    `<span>${item.cantidad || 1}x ${item.nombre}</span>`
                ).join('');
            } else if (data.productos) {
                productosHtml = Object.entries(data.productos).map(([pid, prod]) => 
                    `<span>${prod.cantidad || 1}x ${prod.nombre}</span>`
                ).join('');
            } else {
                productosHtml = '<span>Sin productos</span>';
            }
            
            // ESTILOS
            let borderColor = '#334155';
            let backgroundColor = '#0f172a';
            let animacionPulso = '';
            
            if (estado === 'coccion' && enDemora) {
                borderColor = '#ef4444';
                backgroundColor = '#1a0a0a';
                animacionPulso = 'animation:pulse-demora 1.5s ease-in-out infinite;';
                if (!document.getElementById('demora-keyframes')) {
                    const style = document.createElement('style');
                    style.id = 'demora-keyframes';
                    style.textContent = `
                        @keyframes pulse-demora {
                            0%, 100% { border-color: #ef4444; box-shadow: 0 0 10px rgba(239,68,68,0.1); }
                            50% { border-color: #dc2626; box-shadow: 0 0 25px rgba(239,68,68,0.4); }
                        }
                        @keyframes pulse-badge {
                            0%, 100% { opacity: 1; }
                            50% { opacity: 0.6; }
                        }
                    `;
                    document.head.appendChild(style);
                }
            }
            
            // ALERTA DE DEMORA
            if (sonidoAlerta) {
                setTimeout(() => {
                    try {
                        const audio = new Audio('https://www.soundjay.com/misc/sounds/bell-ringing-05.mp3');
                        audio.volume = 1.0;
                        audio.play().catch(e => console.log('⚠️ Sonido de alerta bloqueado'));
                        if (navigator.vibrate) {
                            navigator.vibrate([500, 200, 500, 200, 500]);
                        }
                        showToast('⚠️ ¡DEMORA! Pedido #' + idPedido + ' superó el tiempo de elaboración.', 'warning');
                    } catch (e) {
                        console.log('⚠️ Error al reproducir alerta:', e);
                    }
                }, 500);
            }
            
            // Botones
            let botones = '';
            if (estado === 'pendiente') {
                botones = `
                    <button class="btn-accion success" onclick="aceptarPedido('${id}')">✅ Aceptar</button>
                    <button class="btn-accion danger" onclick="rechazarPedido('${id}')">❌ Rechazar</button>
                `;
            } else if (estado === 'coccion') {
                botones = `
                    <button class="btn-accion success" onclick="marcarListo('${id}')">✅ Marcar Listo</button>
                    <button class="btn-accion primary" onclick="verDetallePedido('${id}')">📋 Detalle</button>
                    <button class="btn-accion warning" onclick="imprimirComanda('${id}')">🖨️ Imprimir</button>
                `;
            } else if (estado === 'listo' || estado === 'en_reparto') {
                const repartidor = data.repartidor_nombre || data.uid_repartidor || 'Asignado';
                botones = `
                    <span style="font-size:11px;color:#8b5cf6;">🛵 ${repartidor}</span>
                    <button class="btn-accion success" onclick="marcarRecogido('${id}')">🛵 Recogido</button>
                    <button class="btn-accion primary" onclick="verDetallePedido('${id}')">📋 Detalle</button>
                `;
            }
            
            const card = document.createElement('div');
            card.className = 'pedido-card';
            card.style.borderColor = borderColor;
            card.style.backgroundColor = backgroundColor;
            card.style.borderWidth = enDemora && estado === 'coccion' ? '2px' : '1px';
            if (animacionPulso) {
                card.style.animation = 'pulse-demora 1.5s ease-in-out infinite';
            }
            
            card.innerHTML = `
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
                    <span class="id-pedido">#${idPedido}</span>
                    <span class="telefono">📞 ${telefono}</span>
                </div>
                <div class="cliente">${clienteNombre}</div>
                <div class="detalle">${direccion}</div>
                
                <div style="display:flex;justify-content:space-between;align-items:center;margin:6px 0;padding:4px 8px;background:#1e293b;border-radius:6px;border:1px solid ${enDemora && estado === 'coccion' ? '#ef4444' : '#334155'};">
                    <span style="font-size:0.7rem;color:#94a3b8;">${estado === 'coccion' ? '⏱️ Elaboración' : '📌 Estado'}</span>
                    <div style="display:flex;align-items:center;gap:8px;">
                        <span style="font-size:0.8rem;font-weight:600;color:${enDemora && estado === 'coccion' ? '#ef4444' : '#f59e0b'};">
                            ${tiempoDisplay}
                        </span>
                        ${badgeDemora}
                    </div>
                </div>
                
                <div class="productos">${productosHtml}</div>
                <div class="footer">
                    <span class="precio">$${total.toFixed(2)}</span>
                    <span style="font-size:0.6rem;color:#64748b;">${timestamp}</span>
                    <div style="display:flex;gap:4px;flex-wrap:wrap;width:100%;margin-top:4px;">${botones}</div>
                </div>
            `;
            
            container.appendChild(card);
        }

        // ============================================
        // 20. MOSTRAR MENSAJE DE VACÍO
        // ============================================
