                                        const costoMinimo = configEnvios.costo_minimo || 3.00;
                                        const costoMaximo = configEnvios.costo_maximo || 10.00;
                                        
                                        let costo = distanciaKm * tarifaKm;
                                        costo = Math.max(costo, costoMinimo);
                                        costo = Math.min(costo, costoMaximo);
                                        costo = Math.round(costo * 100) / 100;
                                        
                                        costoDisplay.textContent = `${costo.toFixed(2)}€`;
                                        costoDisplay.style.color = '#10b981';
                                        distanciaDisplay.textContent = `📍 ${distanciaKm.toFixed(1)} km`;
                                        calculator.style.borderColor = '#10b981';
                                        
                                        window._costoEnvioCalculado = costo;
                                        window._distanciaCalculada = distanciaKm;
                                        
