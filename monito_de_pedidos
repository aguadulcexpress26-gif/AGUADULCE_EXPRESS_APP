<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Aguadulce Express - Monitor de Pedidos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #020617; font-family: 'Plus Jakarta Sans', sans-serif; color: white; }
        .pedido-card { background: #0f172a; border: 1px solid #1e293b; border-radius: 16px; padding: 16px; margin-bottom: 12px; transition: all 0.2s; }
        .pedido-card.alerta { border-left: 4px solid #f59e0b; }
        .pedido-card.critico { border-left: 4px solid #ef4444; background: rgba(239,68,68,0.1); }
        .badge-estado { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: bold; }
        .badge-recibido { background: rgba(6,182,212,0.2); color: #06b6d4; }
        .badge-proceso { background: rgba(245,158,11,0.2); color: #f59e0b; }
        .badge-reparto { background: rgba(79,70,229,0.2); color: #818cf8; }
        .badge-entregado { background: rgba(34,197,94,0.2); color: #22c55e; }
        .btn-accion { background: #06b6d4; color: #020617; padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: bold; cursor: pointer; border: none; margin-left: 8px; }
        .btn-accion:hover { opacity: 0.8; }
        .tab { padding: 10px 20px; border-radius: 30px; cursor: pointer; transition: all 0.2s; }
        .tab.active { background: #06b6d4; color: #020617; font-weight: bold; }
        .estadistica { background: #0f172a; border-radius: 20px; padding: 16px; text-align: center; border: 1px solid #1e293b; }
        .numero-grande { font-size: 32px; font-weight: 800; color: #06b6d4; }
        audio { display: none; }
    </style>
</head>
<body>

<div id="loader" class="min-h-screen flex items-center justify-center">
    <div class="text-center">
        <div class="spinner w-10 h-10 border-4 border-cyan-400/20 border-t-cyan-400 rounded-full animate-spin mx-auto mb-4"></div>
        <p>Cargando monitor...</p>
    </div>
</div>

<div id="app" style="display: none; max-width: 1400px; margin: 0 auto; padding: 20px;">
    
    <!-- Cabecera -->
    <div class="flex justify-between items-center mb-6 flex-wrap gap-4">
        <div>
            <h1 class="text-2xl font-black italic uppercase text-cyan-400">📊 Monitor de Pedidos</h1>
            <p class="text-white/50 text-xs mt-1">Tiempo real - Actualización cada 10 segundos</p>
        </div>
        <div class="flex gap-3">
            <button id="btnActualizar" class="bg-cyan-400 text-black px-4 py-2 rounded-xl font-bold">🔄 Actualizar</button>
            <button id="btnActivarSonido" class="bg-yellow-500/20 text-yellow-400 px-4 py-2 rounded-xl font-bold">🔊 ACTIVAR SONIDO</button>
        </div>
    </div>

    <!-- Estadísticas rápidas -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6">
        <div class="estadistica">
            <div class="numero-grande" id="totalPendientes">0</div>
            <div class="text-xs text-white/50">⚠️ Sin confirmar</div>
        </div>
        <div class="estadistica">
            <div class="numero-grande text-amber-400" id="totalCocina">0</div>
            <div class="text-xs text-white/50">🍳 En cocina</div>
        </div>
        <div class="estadistica">
            <div class="numero-grande text-purple-400" id="totalReparto">0</div>
            <div class="text-xs text-white/50">🛵 En reparto</div>
        </div>
        <div class="estadistica">
            <div class="numero-grande text-emerald-400" id="totalEntregados">0</div>
            <div class="text-xs text-white/50">✅ Entregados hoy</div>
        </div>
        <div class="estadistica">
            <div class="numero-grande text-cyan-400" id="totalVentas">0€</div>
            <div class="text-xs text-white/50">💰 Ventas hoy</div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
        <div class="tab active" data-tab="pendientes">⚠️ SIN CONFIRMAR</div>
        <div class="tab" data-tab="cocina">🍳 EN COCINA</div>
        <div class="tab" data-tab="reparto">🛵 EN REPARTO</div>
        <div class="tab" data-tab="historial">✅ HISTORIAL</div>
    </div>

    <!-- Lista de pedidos -->
    <div id="listaPedidos"></div>

</div>

<audio id="audio-alerta" preload="auto">
    <source src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" type="audio/mpeg">
</audio>

<script>
    const firebaseConfig = {
        apiKey: "AIzaSyCJcLQ0ikUwZSV7L_8mLLax8B5qnhP0Roc",
        authDomain: "aguadulce-notificaciones.firebaseapp.com",
        databaseURL: "https://aguadulce-notificaciones-default-rtdb.firebaseio.com",
        projectId: "aguadulce-notificaciones",
        storageBucket: "aguadulce-notificaciones.firebasestorage.app",
    };
    if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
    const database = firebase.database();
    const scriptURL = "https://script.google.com/macros/s/AKfycbzYFDShcrP7I4FKhiH3q5UcEInpSKJstrumJ9ddI4Tj9S31ZUgwiuie81fGFmCJ6ob2/exec";

    let todosLosPedidos = [];
    let restaurantes = [];
    let sonidoActivado = localStorage.getItem('monitor_sonido') === 'true';
    let audioElement = null;
    let tabActual = 'pendientes';
    let ultimoConteoPendientes = 0;

    function initAudio() {
        audioElement = document.getElementById('audio-alerta');
        audioElement.volume = 0.8;
    }

    function playSound() {
        if (audioElement && sonidoActivado) {
            audioElement.currentTime = 0;
            audioElement.play().catch(e => console.log('Audio necesita interacción'));
        }
    }

    async function cargarRestaurantes() {
        try {
            const response = await fetch(`${scriptURL}?action=cargarTodo&t=${Date.now()}`);
            const data = await response.json();
            restaurantes = data.RESTAURANTES || [];
            console.log("✅ Restaurantes cargados:", restaurantes.length);
        } catch (error) {
            console.error("Error cargando restaurantes:", error);
        }
    }

    function getNombreRestaurante(idRest) {
        const rest = restaurantes.find(r => String(r.ID_RESTAURANTE).trim() === String(idRest).trim());
        return rest ? (rest.NOMBRE_RESTAURANTE || rest.NOMBRE || idRest) : idRest;
    }

    function getColorEstado(estado) {
        const e = estado.toUpperCase();
        if (e === 'RECIBIDO' || e === 'NUEVO') return 'badge-recibido';
        if (e === 'EN PROCESO' || e === 'LISTO') return 'badge-proceso';
        if (e === 'EN CAMINO' || e === 'RECOGIDO') return 'badge-reparto';
        if (e === 'ENTREGADO' || e === 'FINALIZADO') return 'badge-entregado';
        return 'badge-recibido';
    }

    function getTextoEstado(estado) {
        const e = estado.toUpperCase();
        if (e === 'RECIBIDO') return '📥 RECIBIDO - SIN CONFIRMAR';
        if (e === 'NUEVO') return '🆕 NUEVO - SIN CONFIRMAR';
        if (e === 'EN PROCESO') return '🍳 EN COCINA';
        if (e === 'LISTO') return '✅ LISTO PARA REPARTIDOR';
        if (e === 'RECOGIDO') return '🛵 REPARTIDOR EN CAMINO';
        if (e === 'EN CAMINO') return '🛵 REPARTIDOR EN CAMINO';
        if (e === 'LLEGÓ') return '📍 REPARTIDOR EN EL CLIENTE';
        if (e === 'ENTREGADO') return '🎉 ENTREGADO';
        return estado;
    }

    function getTiempoTranscurrido(fechaStr) {
        if (!fechaStr) return { texto: '---', minutos: 0 };
        const fecha = new Date(fechaStr);
        const diffMs = Date.now() - fecha.getTime();
        const diffMin = Math.floor(diffMs / 60000);
        if (diffMin < 1) return { texto: 'Hace segundos', minutos: 0 };
        if (diffMin < 60) return { texto: `Hace ${diffMin} min`, minutos: diffMin };
        return { texto: `Hace ${Math.floor(diffMin/60)}h ${diffMin%60}min`, minutos: diffMin };
    }

    async function cargarPedidos() {
        try {
            const response = await fetch(`${scriptURL}?action=cargarTodo&t=${Date.now()}`);
            const data = await response.json();
            const pedidos = data.PEDIDOS || [];
            
            // Enriquecer pedidos con datos del restaurante
            todosLosPedidos = pedidos.map(p => ({
                ...p,
                restaurante_nombre: getNombreRestaurante(p.ID_RESTAURANTE),
                tiempo: getTiempoTranscurrido(p.FECHA)
            }));

            // Calcular estadísticas
            const hoy = new Date().toLocaleDateString('es-ES');
            const pendientes = todosLosPedidos.filter(p => {
                const e = (p.ESTADO || '').toUpperCase();
                return e === 'RECIBIDO' || e === 'NUEVO';
            });
            const cocina = todosLosPedidos.filter(p => {
                const e = (p.ESTADO || '').toUpperCase();
                return e === 'EN PROCESO' || e === 'LISTO';
            });
            const reparto = todosLosPedidos.filter(p => {
                const e = (p.ESTADO || '').toUpperCase();
                return e === 'RECOGIDO' || e === 'EN CAMINO' || e === 'LLEGÓ';
            });
            const entregados = todosLosPedidos.filter(p => {
                const e = (p.ESTADO || '').toUpperCase();
                return e === 'ENTREGADO' || e === 'FINALIZADO';
            });
            const ventasHoy = entregados.reduce((sum, p) => sum + (parseFloat(p.TOTAL) || 0), 0);

            document.getElementById('totalPendientes').innerText = pendientes.length;
            document.getElementById('totalCocina').innerText = cocina.length;
            document.getElementById('totalReparto').innerText = reparto.length;
            document.getElementById('totalEntregados').innerText = entregados.length;
            document.getElementById('totalVentas').innerText = ventasHoy.toFixed(2) + '€';

            // Alerta si hay nuevos pedidos sin confirmar
            if (pendientes.length > ultimoConteoPendientes && pendientes.length > 0) {
                playSound();
                if (Notification.permission === 'granted') {
                    new Notification('📦 Nuevo pedido sin confirmar', {
                        body: `Hay ${pendientes.length} pedido(s) que el restaurante no ha aceptado.`,
                        icon: 'https://i.postimg.cc/mZwjLXxw/Logo-Aguadulce-Express.jpg'
                    });
                }
            }
            ultimoConteoPendientes = pendientes.length;

            renderizarPedidos();

        } catch (error) {
            console.error("Error cargando pedidos:", error);
        }
    }

    function renderizarPedidos() {
        let pedidosFiltrados = [];
        if (tabActual === 'pendientes') {
            pedidosFiltrados = todosLosPedidos.filter(p => {
                const e = (p.ESTADO || '').toUpperCase();
                return e === 'RECIBIDO' || e === 'NUEVO';
            }).sort((a,b) => new Date(b.FECHA) - new Date(a.FECHA));
        } else if (tabActual === 'cocina') {
            pedidosFiltrados = todosLosPedidos.filter(p => {
                const e = (p.ESTADO || '').toUpperCase();
                return e === 'EN PROCESO' || e === 'LISTO';
            }).sort((a,b) => new Date(b.FECHA) - new Date(a.FECHA));
        } else if (tabActual === 'reparto') {
            pedidosFiltrados = todosLosPedidos.filter(p => {
                const e = (p.ESTADO || '').toUpperCase();
                return e === 'RECOGIDO' || e === 'EN CAMINO' || e === 'LLEGÓ';
            }).sort((a,b) => new Date(b.FECHA) - new Date(a.FECHA));
        } else {
            pedidosFiltrados = todosLosPedidos.filter(p => {
                const e = (p.ESTADO || '').toUpperCase();
                return e === 'ENTREGADO' || e === 'FINALIZADO';
            }).slice(0, 50).sort((a,b) => new Date(b.FECHA) - new Date(a.FECHA));
        }

        const contenedor = document.getElementById('listaPedidos');
        if (pedidosFiltrados.length === 0) {
            contenedor.innerHTML = '<div class="text-center py-20 text-white/30">📭 No hay pedidos en esta categoría</div>';
            return;
        }

        let html = '';
        for (let p of pedidosFiltrados) {
            const estado = (p.ESTADO || '').toUpperCase();
            const esPendiente = estado === 'RECIBIDO' || estado === 'NUEVO';
            let alertaClass = '';
            let alertaMensaje = '';
            if (esPendiente && p.tiempo.minutos >= 10) {
                alertaClass = 'critico';
                alertaMensaje = '<span class="text-red-400 text-xs ml-2">⚠️ CRÍTICO: +10 min sin aceptar</span>';
            } else if (esPendiente && p.tiempo.minutos >= 5) {
                alertaClass = 'alerta';
                alertaMensaje = '<span class="text-yellow-400 text-xs ml-2">⚠️ +5 min sin aceptar</span>';
            }

            html += `
                <div class="pedido-card ${alertaClass}">
                    <div class="flex justify-between items-start flex-wrap gap-2">
                        <div>
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="font-mono font-bold text-cyan-400">#${p.ID_PEDIDO}</span>
                                <span class="badge-estado ${getColorEstado(p.ESTADO)}">${getTextoEstado(p.ESTADO)}</span>
                                ${alertaMensaje}
                            </div>
                            <div class="text-white text-sm font-bold mt-1">${p.CLIENTE || 'Cliente'}</div>
                            <div class="text-white/40 text-xs mt-1">${p.DIRECCION || 'Sin dirección'}</div>
                        </div>
                        <div class="text-right">
                            <div class="text-emerald-400 font-bold text-lg">${(parseFloat(p.TOTAL) || 0).toFixed(2)}€</div>
                            <div class="text-white/40 text-xs">${p.tiempo.texto}</div>
                        </div>
                    </div>
                    <div class="mt-3 pt-2 border-t border-white/10 flex justify-between items-center flex-wrap gap-2">
                        <div class="text-sm">
                            <span class="text-white/60">🏪 ${p.restaurante_nombre}</span>
                            ${p.REPARTIDOR ? `<span class="text-white/40 ml-3">🛵 ${p.REPARTIDOR}</span>` : ''}
                        </div>
                        ${esPendiente ? `<button class="btn-accion" onclick="notificarRestaurante('${p.ID_PEDIDO}', '${p.restaurante_nombre}')">📢 NOTIFICAR RESTAURANTE</button>` : ''}
                    </div>
                </div>
            `;
        }
        contenedor.innerHTML = html;
    }

    function notificarRestaurante(idPedido, nombreRest) {
        Swal.fire({
            title: '📢 Notificar al restaurante',
            text: `¿Quieres enviar una alerta a ${nombreRest} para que revise el pedido #${idPedido}?`,
            icon: 'question',
            background: '#020617', color: 'white',
            confirmButtonColor: '#f59e0b', confirmButtonText: 'Sí, notificar',
            showCancelButton: true
        }).then(async (result) => {
            if (result.isConfirmed) {
                // Aquí se podría implementar una notificación push al restaurante
                Swal.fire({ title: '✅ Notificación enviada', text: 'Se ha alertado al restaurante', icon: 'success', background: '#020617', color: 'white', timer: 2000, showConfirmButton: false });
                playSound();
            }
        });
    }

    function activarSonido() {
        sonidoActivado = !sonidoActivado;
        localStorage.setItem('monitor_sonido', sonidoActivado);
        const btn = document.getElementById('btnActivarSonido');
        if (sonidoActivado) {
            btn.innerHTML = '🔊 SONIDO ACTIVADO';
            btn.style.background = '#22c55e';
            btn.style.color = '#020617';
            playSound();
        } else {
            btn.innerHTML = '🔇 ACTIVAR SONIDO';
            btn.style.background = '#f59e0b';
            btn.style.color = '#020617';
        }
    }

    async function iniciarMonitor() {
        initAudio();
        await cargarRestaurantes();
        await cargarPedidos();
        document.getElementById('loader').style.display = 'none';
        document.getElementById('app').style.display = 'block';

        const btnSonido = document.getElementById('btnActivarSonido');
        if (sonidoActivado) {
            btnSonido.innerHTML = '🔊 SONIDO ACTIVADO';
            btnSonido.style.background = '#22c55e';
        } else {
            btnSonido.innerHTML = '🔇 ACTIVAR SONIDO';
            btnSonido.style.background = '#f59e0b';
        }
        btnSonido.onclick = activarSonido;

        document.getElementById('btnActualizar').onclick = () => cargarPedidos();

        document.querySelectorAll('.tab').forEach(tab => {
            tab.onclick = () => {
                document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
                tab.classList.add('active');
                tabActual = tab.dataset.tab;
                renderizarPedidos();
            };
        });

        setInterval(cargarPedidos, 10000);
        
        if ('Notification' in window && Notification.permission !== 'granted' && Notification.permission !== 'denied') {
            Notification.requestPermission();
        }
    }

    iniciarMonitor();
</script>
</body>
</html>
