        // 29.1 CALCULAR COSTO DE ENVÍO
        async function calcularCostoEnvio(direccionCliente) {
            try {
                const restSnap = await db.ref(`restaurantes/${restauranteId}`).once('value');
                const restaurante = restSnap.val();
                const direccionRestaurante = restaurante.direccion || restaurante.DIRECCION || '';
                
                if (!direccionRestaurante) {
                    console.warn('⚠️ Restaurante sin dirección configurada, usando costo fijo');
                    return 5.00;
                }
                
                console.log(`📤 Calculando distancia desde "${direccionRestaurante}" hasta "${direccionCliente}"...`);
                
                const calcularDistancia = firebase.functions().httpsCallable('calcularDistancia');
                const result = await calcularDistancia({
                    origen: direccionRestaurante,
                    destino: direccionCliente
                });
                
                console.log('📨 Respuesta de Cloud Function:', result.data);
                
                if (result.data.success) {
                    const distanciaKm = result.data.distanciaKm;
                    const DISTANCIA_MAXIMA_KM = 20;
                    
                    if (distanciaKm > DISTANCIA_MAXIMA_KM) {
                        console.warn(`⚠️ La dirección está fuera de Roquetas de Mar (${distanciaKm.toFixed(2)} km)`);
                        return -1;
                    }
                    
                    const tarifaKm = restaurante.tarifa_envio_km || 1.50;
                    const costoMinimo = restaurante.costo_envio_minimo || 3.00;
                    const costoMaximo = restaurante.costo_envio_maximo || 10.00;
                    
                    let costo = distanciaKm * tarifaKm;
                    costo = Math.max(costo, costoMinimo);
                    costo = Math.min(costo, costoMaximo);
                    costo = Math.round(costo * 100) / 100;
                    
                    console.log(`📍 Distancia: ${distanciaKm.toFixed(2)} km`);
                    console.log(`💰 Costo de envío: $${costo.toFixed(2)}`);
                    
                    return costo;
                } else {
                    console.warn('⚠️ No se pudo calcular distancia, usando costo fijo');
                    return 5.00;
                }
                
            } catch (error) {
                console.error('❌ Error al calcular costo de envío:', error);
                return 5.00;
            }
        }

