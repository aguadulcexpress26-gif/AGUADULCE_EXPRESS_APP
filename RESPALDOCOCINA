                            const nombreTruncado = nombre.length > 20 ? nombre.substring(0, 18) + '..' : nombre;
                            const espacios = 22 - nombreTruncado.length;
                            return `${cantidad}x ${nombreTruncado}${' '.repeat(espacios > 0 ? espacios : 0)}$${precio.toFixed(2)}`;
