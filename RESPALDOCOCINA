        ${'-'.repeat(32)}
        ${' '.repeat(18)}Subtotal  $${subtotal.toFixed(2)}
        ${' '.repeat(18)}Envío     $${envio.toFixed(2)}
        ${' '.repeat(18)}Uso App   $${usoApp.toFixed(2)}
