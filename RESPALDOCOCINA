            // ============================================
            window.notificarRepartidor = async function(pedidoId) {
                try {
                    const pedidoSnap = await db.ref(`pedidos/${pedidoId}`).once('value');
                    const pedido = pedidoSnap.val();
                    
                    if (!pedido) return;

                    const repartidoresSnap = await db.ref('repartidores')
                        .orderByChild('activo')
                        .equalTo(true)
                        .once('value');
                    
                    const repartidores = repartidoresSnap.val();
                    
                    if (!repartidores) {
                        console.warn('⚠️ No hay repartidores disponibles');
                        return;
                    }

                    let repartidorId = null;
                    let repartidorData = null;
                    let menorCarga = Infinity;
                    
                    for (const [uid, data] of Object.entries(repartidores)) {
                        const pedidosActivosSnap = await db.ref('pedidos')
                            .orderByChild('uid_repartidor')
                            .equalTo(uid)
                            .once('value');
                        
                        const pedidosActivos = pedidosActivosSnap.val();
                        let carga = 0;
                        
                        if (pedidosActivos) {
                            for (const [pid, pData] of Object.entries(pedidosActivos)) {
                                const estado = pData.estado ? pData.estado.toUpperCase() : '';
                                if (estado !== 'ENTREGADO' && estado !== 'CANCELADO_POR_AUSENCIA') {
                                    carga++;
                                }
                            }
                        }
                        
                        if (carga < menorCarga) {
                            menorCarga = carga;
                            repartidorId = uid;
                            repartidorData = data;
                        }
                    }
                    
                    if (!repartidorId) return;

                    await db.ref(`pedidos/${pedidoId}/uid_repartidor`).set(repartidorId);
                    await db.ref(`pedidos/${pedidoId}/repartidor_nombre`).set(repartidorData.nombre || 'Repartidor');
                    await db.ref(`pedidos/${pedidoId}/timestamp_asignacion`).set(Date.now());
                    await db.ref(`pedidos/${pedidoId}/historial`).push({
                        estado: 'coccion',
                        timestamp: Date.now(),
                        usuario: currentUser.uid,
                        accion: 'asignar_repartidor',
                        repartidor: repartidorId,
                        repartidor_nombre: repartidorData.nombre || 'Repartidor'
                    });

                    const token = repartidorData.token;
                    
                    if (!token) {
                        showToast('⚠️ El repartidor no tiene notificaciones activas', 'warning');
                        return;
                    }
                    
                    const titulo = '🛵 Nuevo pedido disponible';
                    const mensaje = `Recoge el pedido de ${pedido.cliente_nombre || 'cliente'}`;
                    
                    try {
                        const enviarNotificacion = functions.httpsCallable('enviarNotificationPedido');
                        
                        await enviarNotificacion({
                            token: token,
                            titulo: titulo,
                            mensaje: mensaje,
                            data: { 
                                tipo: 'pedido', 
                                uid: repartidorId,
                                pedidoId: pedidoId
                            }
                        });
                        
                        showToast(`✅ Repartidor asignado: ${repartidorData.nombre || 'Repartidor'}`, 'success');
                        
                    } catch (error) {
                        console.error('❌ Error al enviar notificación:', error);
                        showToast('⚠️ Repartidor asignado pero notificación falló', 'warning');
                    }
                    
                } catch (error) {
                    console.error('❌ Error en notificarRepartidor:', error);
                }
            };

