<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="screen-orientation" content="landscape">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="mobile-web-app-capable" content="yes">
    <title>Aguadulce Express - Cocina</title>
    
    <link rel="manifest" href="/AGUADULCE_EXPRESS_APP/cocina/manifest-cocina.json">
    <link rel="apple-touch-icon" href="https://i.postimg.cc/cCv7qsHf/IMAGEN-PNG-512.jpg">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-messaging-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-functions-compat.js"></script>

    <style>
        /* ============================================
           RESET Y ESTILOS GLOBALES
           ============================================ */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background: #0f172a;
        }
        
        /* ============================================
           LOGIN
           ============================================ */
        #login-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            min-height: 100dvh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 1rem;
            position: fixed;
            inset: 0;
            z-index: 100;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }
        
        #login-container.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }
        
        .login-card {
            background: white;
            border-radius: 1.5rem;
            padding: 2.5rem;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            animation: slideUp 0.5s ease-out;
        }
        
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .login-card h1 { font-size: 2rem; font-weight: 700; color: #1f2937; text-align: center; margin-bottom: 0.5rem; }
        .login-card .subtitle { text-align: center; color: #6b7280; margin-bottom: 2rem; }
        
        .login-card input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 2px solid #e5e7eb;
            border-radius: 0.75rem;
            font-size: 1rem;
            transition: all 0.3s;
            background: #f9fafb;
            color: #1f2937;
        }
        
        .login-card input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            background: white;
        }
        
        .login-card button[type="submit"] {
            width: 100%;
            padding: 0.75rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 0.75rem;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .login-card button[type="submit"]:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        }
        
        .login-card button[type="submit"]:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }
        
        /* ============================================
           APP PRINCIPAL
           ============================================ */
        #app {
            display: none;
            flex-direction: column;
            width: 100vw;
            height: 100vh;
            height: 100dvh;
            background: #0f172a;
            position: fixed;
            inset: 0;
            z-index: 10;
        }
        #app:not(.hidden) { display: flex; }
        
        /* ============================================
           HEADER
           ============================================ */
        .app-header {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            padding: 0.75rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #f59e0b;
            flex-shrink: 0;
            min-height: 70px;
        }
        
        .app-header .logo { display: flex; align-items: center; gap: 0.75rem; }
        .app-header .logo h1 { color: #f59e0b; font-size: 1.25rem; font-weight: 700; }
        .app-header .logo span { color: #94a3b8; font-size: 0.75rem; }
        
        .app-header .restaurante-info { text-align: right; color: white; }
        .app-header .restaurante-info .nombre { font-weight: 600; font-size: 1rem; }
        .app-header .restaurante-info .email { font-size: 0.75rem; color: #94a3b8; }
        
        /* ============================================
           PAUSA BANNER
           ============================================ */
        .pausa-banner {
            background: #dc2626;
            color: white;
            text-align: center;
            padding: 8px 16px;
            font-weight: 700;
            font-size: 14px;
            letter-spacing: 2px;
            display: none;
            flex-shrink: 0;
        }
        .pausa-banner.active { display: block; animation: pulse-banner 1.5s ease-in-out infinite; }
        
        @keyframes pulse-banner {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.6; }
        }
        
        /* ============================================
           CONTADORES
           ============================================ */
        .contadores {
            display: flex;
            gap: 1rem;
            background: #1e293b;
            padding: 0.5rem 2rem;
            flex-shrink: 0;
            border-bottom: 1px solid #334155;
            flex-wrap: wrap;
            align-items: center;
        }
        
        .contador-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #94a3b8;
            font-size: 0.875rem;
            font-weight: 500;
        }
        
        .contador-item .badge {
            padding: 0.125rem 0.75rem;
            border-radius: 9999px;
            font-weight: 700;
            font-size: 0.75rem;
        }
        
        .contador-item .badge.pendiente { background: #f59e0b; color: #0f172a; }
        .contador-item .badge.coccion { background: #3b82f6; color: white; }
        .contador-item .badge.listo { background: #10b981; color: white; }
        .contador-item .badge.reparto { background: #8b5cf6; color: white; }
        
        .contador-item.separador { border-left: 1px solid #334155; padding-left: 1rem; }
        
        .btn-pausa {
            padding: 4px 16px;
            border-radius: 20px;
            border: none;
            font-weight: 700;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.3s;
            margin-left: auto;
        }
        .btn-pausa.activo { background: #dc2626; color: white; }
        .btn-pausa.activo:hover { background: #b91c1c; }
        .btn-pausa.inactivo { background: #22c55e; color: white; }
        .btn-pausa.inactivo:hover { background: #16a34a; }
        
        /* ============================================
           COLUMNAS
           ============================================ */
        .columnas-container {
            flex: 1;
            display: flex;
            gap: 1rem;
            padding: 1rem;
            overflow-x: auto;
            overflow-y: hidden;
            background: #0f172a;
            min-height: 0;
        }
        
        .columna {
            flex: 1;
            min-width: 280px;
            max-width: 400px;
            background: #1e293b;
            border-radius: 1rem;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border: 1px solid #334155;
            transition: all 0.3s ease;
        }
        
        .columna-header {
            padding: 0.75rem 1rem;
            font-weight: 600;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid transparent;
            flex-shrink: 0;
        }
        
        .columna-header .titulo { display: flex; align-items: center; gap: 0.5rem; }
        .columna-header .cantidad {
            background: rgba(255,255,255,0.1);
            padding: 0.125rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
        }
        
        .columna-pendiente .columna-header { color: #f59e0b; border-bottom-color: #f59e0b; }
        .columna-coccion .columna-header { color: #3b82f6; border-bottom-color: #3b82f6; }
        .columna-listo .columna-header { color: #10b981; border-bottom-color: #10b981; }
        
        .columna-contenido {
            flex: 1;
            overflow-y: auto;
            padding: 0.75rem;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }
        
        /* ============================================
           TARJETAS DE PEDIDOS
           ============================================ */
        .pedido-card {
            background: #0f172a;
            border-radius: 0.75rem;
            padding: 1rem;
            border: 1px solid #334155;
            transition: all 0.3s;
            flex-shrink: 0;
        }
        .pedido-card:hover { border-color: #f59e0b; transform: translateY(-2px); box-shadow: 0 4px 15px rgba(0,0,0,0.3); }
        
        .pedido-card .cliente { font-weight: 600; color: white; font-size: 0.9rem; }
        .pedido-card .detalle { color: #94a3b8; font-size: 0.8rem; margin-top: 0.25rem; }
        .pedido-card .productos {
            color: #cbd5e1;
            font-size: 0.75rem;
            margin-top: 0.5rem;
            padding-top: 0.5rem;
            border-top: 1px solid #334155;
        }
        .pedido-card .productos span {
            display: inline-block;
            background: #1e293b;
            padding: 0.125rem 0.5rem;
            border-radius: 9999px;
            margin: 0.125rem 0.25rem 0.125rem 0;
            font-size: 0.7rem;
            color: #94a3b8;
        }
        
        .pedido-card .footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 0.75rem;
            padding-top: 0.75rem;
            border-top: 1px solid #334155;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        
        .pedido-card .footer .precio { color: #f59e0b; font-weight: 700; font-size: 0.9rem; }
        .pedido-card .footer .tiempo { color: #64748b; font-size: 0.7rem; }
        .pedido-card .id-pedido { font-size: 0.65rem; color: #64748b; font-family: monospace; }
        .pedido-card .telefono { color: #94a3b8; font-size: 0.75rem; }
        
        .pedido-card .tiempo-elaboracion {
            font-size: 0.7rem;
            padding: 0.125rem 0.5rem;
            border-radius: 9999px;
            background: #1e293b;
            color: #94a3b8;
            display: inline-block;
        }
        .pedido-card .tiempo-elaboracion.buena { color: #10b981; }
        .pedido-card .tiempo-elaboracion.media { color: #f59e0b; }
        .pedido-card .tiempo-elaboracion.mala { color: #ef4444; }
        
        .btn-accion {
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.7rem;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s;
        }
        .btn-accion:hover { transform: scale(1.05); }
        .btn-accion.primary { background: #f59e0b; color: #0f172a; }
        .btn-accion.primary:hover { background: #d97706; }
        .btn-accion.success { background: #10b981; color: white; }
        .btn-accion.success:hover { background: #059669; }
        .btn-accion.warning { background: #f59e0b; color: #0f172a; }
        .btn-accion.warning:hover { background: #d97706; }
        .btn-accion.danger { background: #ef4444; color: white; }
        .btn-accion.danger:hover { background: #dc2626; }
        .btn-accion.envio { background: #8b5cf6; color: white; }
        .btn-accion.envio:hover { background: #7c3aed; }
        
        /* ============================================
           MENÚ HAMBURGUESA
           ============================================ */
        #menu-toggle {
            position: fixed;
            top: 0.75rem;
            left: 0.75rem;
            z-index: 50;
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 0.75rem;
            padding: 0.5rem 0.75rem;
            font-size: 1.25rem;
            color: white;
            cursor: pointer;
            transition: all 0.3s;
            display: none !important;
        }
        #app:not(.hidden) #menu-toggle { display: flex !important; align-items: center; justify-content: center; }
        #menu-toggle:hover { background: #334155; }
        #menu-toggle.active { background: #ef4444; border-color: #ef4444; }
        
        /* ============================================
           MENÚ DESPLEGABLE
           ============================================ */
        #menu-desplegable {
            position: fixed;
            top: 0;
            left: 0;
            width: 280px;
            height: 100vh;
            background: #1e293b;
            box-shadow: 4px 0 20px rgba(0,0,0,0.3);
            transform: translateX(-100%);
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 40;
            padding: 5rem 1.5rem 2rem;
            overflow-y: auto;
            border-right: 1px solid #334155;
        }
        #menu-desplegable.open { transform: translateX(0); }
        
        #menu-desplegable .menu-item {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            color: #94a3b8;
            cursor: pointer;
            transition: all 0.2s;
            margin-bottom: 0.25rem;
            border: none;
            background: transparent;
            width: 100%;
            font-size: 0.9rem;
        }
        #menu-desplegable .menu-item:hover { background: #334155; color: white; }
        #menu-desplegable .menu-item.active { background: #f59e0b; color: #0f172a; }
        #menu-desplegable .menu-item.danger { color: #ef4444; }
        #menu-desplegable .menu-item.danger:hover { background: #7f1d1d; color: #fca5a5; }
        #menu-desplegable .menu-item .badge-menu {
            margin-left: auto;
            background: #3b82f6;
            color: white;
            padding: 0.125rem 0.5rem;
            border-radius: 9999px;
            font-size: 0.7rem;
        }
        
        /* ============================================
           TOAST NOTIFICATIONS
           ============================================ */
        .toast {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            padding: 1rem 1.5rem;
            border-radius: 0.75rem;
            color: white;
            font-weight: 500;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            z-index: 999;
            animation: slideIn 0.3s ease-out;
            max-width: 400px;
        }
        @keyframes slideIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .toast-success { background: #10b981; }
        .toast-error { background: #ef4444; }
        .toast-info { background: #3b82f6; }
        .toast-warning { background: #f59e0b; color: #0f172a; }
        
        /* ============================================
           OVERLAY DE ORIENTACIÓN
           ============================================ */
        #orientacion-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.95);
            z-index: 9999;
            align-items: center;
            justify-content: center;
        }
        #orientacion-overlay:not(.hidden) { display: flex !important; }
        
        /* ============================================
           BOTÓN DE INSTALACIÓN PWA
           ============================================ */
        #install-btn {
            display: none !important;
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 50;
            padding: 0.6rem 1.25rem;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: #0f172a;
            border: none;
            border-radius: 9999px;
            font-weight: 700;
            box-shadow: 0 8px 30px rgba(245,158,11,0.4);
            cursor: pointer;
            transition: all 0.3s;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
        }
        #app:not(.hidden) #install-btn { display: flex !important; }
        #install-btn:hover { transform: translateY(-2px) scale(1.05); box-shadow: 0 12px 40px rgba(245,158,11,0.5); }
        
        /* ============================================
           SCROLLBAR
           ============================================ */
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-track { background: #1e293b; border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: #f59e0b; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #d97706; }
        
        /* ============================================
           RESPONSIVE
           ============================================ */
        @media (max-width: 1024px) {
            .columnas-container { flex-direction: column; overflow-y: auto; overflow-x: hidden; padding: 0.5rem; }
            .columna { min-width: unset; max-width: unset; max-height: 300px; }
        }
        
        @media (max-width: 768px) {
            .app-header { padding: 0.5rem 1rem; flex-direction: column; align-items: flex-start; gap: 0.25rem; min-height: 60px; }
            .app-header .restaurante-info { text-align: left; width: 100%; }
            .contadores { padding: 0.5rem 1rem; flex-wrap: wrap; gap: 0.5rem; }
            .contador-item { font-size: 0.7rem; }
            .columna { min-width: unset; max-height: 250px; }
            .pedido-card { padding: 0.75rem; }
        }
    </style>
</head>
<body>

    <!-- ============================================
    LOGIN CONTAINER
    ============================================ -->
    <div id="login-container">
        <div class="login-card">
            <h1>🍳 Aguadulce Express</h1>
            <p class="subtitle">Panel de Cocina</p>
            
            <form id="login-form" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input type="email" id="login-email" placeholder="restaurante@email.com" required>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Contraseña</label>
                    <input type="password" id="login-password" placeholder="••••••••" required>
                </div>
                <button type="submit" id="login-btn">
                    <span id="login-text">Iniciar Sesión</span>
                    <span id="login-loading" class="hidden">Cargando...</span>
                </button>
                <div id="login-error" class="text-red-500 text-sm text-center hidden"></div>
            </form>
        </div>
    </div>

    <!-- ============================================
    APP PRINCIPAL
    ============================================ -->
    <div id="app" class="hidden">
        
        <!-- MENÚ HAMBURGUESA -->
        <button id="menu-toggle" aria-label="Menú">☰</button>
        
        <!-- MENÚ DESPLEGABLE -->
        <div id="menu-desplegable">
            <div class="mb-6 pb-4 border-b border-gray-700">
                <div class="font-bold text-lg text-white" id="restaurante-nombre">Cargando...</div>
                <div class="text-sm text-gray-400" id="restaurante-email"></div>
                <div class="text-xs text-gray-500 mt-2" id="estado-pausa-menu">● Activo</div>
            </div>
            
            <button class="menu-item active" data-view="activos">
                <span>📋</span> Pedidos Activos
                <span class="badge-menu" id="contador-activos">0</span>
            </button>
            
            <button class="menu-item" data-view="historial">
                <span>📊</span> Historial
            </button>
            
            <button class="menu-item" data-view="demoras">
                <span>⏱️</span> Registro de Demoras
            </button>
            
            <div class="mt-4 pt-4 border-t border-gray-700">
                <button class="menu-item" onclick="abrirFormularioReparto()">
                    <span>🚚</span> Nuevo Reparto
                </button>
                <button class="menu-item" id="btn-pausa" onclick="togglePausa()">
                    <span id="icono-pausa">⏸️</span>
                    <span id="texto-pausa">Pausar Pedidos</span>
                </button>
                <button class="menu-item danger" id="btn-cerrar-sesion">
                    <span>🚪</span> Cerrar Sesión
                </button>
            </div>
        </div>
        
        <!-- BANNER DE PAUSA -->
        <div class="pausa-banner" id="pausa-banner">
            ⏸️ RESTAURANTE EN PAUSA - NO SE RECIBEN NUEVOS PEDIDOS
        </div>
        
        <!-- HEADER CON BANNER -->
        <div class="app-header">
            <div class="logo">
                <span style="font-size: 1.5rem;">🍳</span>
                <div>
                    <h1>Aguadulce Express</h1>
                    <span>Panel de Cocina</span>
                </div>
            </div>
            <div class="restaurante-info">
                <div class="nombre" id="header-restaurante">Cargando...</div>
                <div class="email" id="header-email"></div>
            </div>
        </div>
        
        <!-- CONTADORES -->
        <div class="contadores">
            <div class="contador-item">
                📥 Entrada
                <span class="badge pendiente" id="count-pendiente">0</span>
            </div>
            <div class="contador-item">
                👨‍🍳 En Proceso
                <span class="badge coccion" id="count-coccion">0</span>
            </div>
            <div class="contador-item">
                ✅ Listo
                <span class="badge listo" id="count-listo">0</span>
            </div>
            <button id="btn-pausa-header" onclick="togglePausa()" class="btn-pausa inactivo">
                ⏸️ Pausar
            </button>
        </div>
        
        <!-- COLUMNAS -->
        <div class="columnas-container" id="columnas-container">
            
            <!-- COLUMNA: ENTRADA -->
            <div class="columna columna-pendiente" id="columna-pendiente">
                <div class="columna-header">
                    <span class="titulo">📥 Entrada</span>
                    <span class="cantidad" id="col-count-pendiente">0</span>
                </div>
                <div class="columna-contenido" id="col-pendiente">
                    <!-- Pedidos pendientes -->
                </div>
            </div>
            
            <!-- COLUMNA: EN PROCESO -->
            <div class="columna columna-coccion" id="columna-coccion">
                <div class="columna-header">
                    <span class="titulo">👨‍🍳 En Proceso</span>
                    <span class="cantidad" id="col-count-coccion">0</span>
                </div>
                <div class="columna-contenido" id="col-coccion">
                    <!-- Pedidos en cocción -->
