                                    <div class="ganancias-detalle-item" style="background:rgba(139,92,246,0.08);border-left:3px solid var(--accent-purple);">
                                        <div class="col-pedido">
                                            <div class="pedido-id" style="color:var(--accent-purple);">📦 #${p.id} · ${escapeHTML(p.cliente)}</div>
                                            <div class="pedido-fecha">${fechaStr} · Reparto Personal</div>
                                        </div>
                                        <div class="col-base" style="color:var(--text-muted);">—</div>
                                        <div class="col-comision" style="color:var(--text-muted);">—</div>
                                        <div class="col-demora" style="color:var(--text-muted);">—</div>
                                        <div class="col-liquidar" style="color:var(--accent-purple);">-${p.montoReparto.toFixed(2)}€</div>
                                    </div>
                                `;
                            } else {
                                // Fila de pedido normal
                                html += `
                                    <div class="ganancias-detalle-item ${tieneDemora ? 'con-demora' : ''}">
                                        <div class="col-pedido">
                                            <div class="pedido-id">#${p.id} · ${escapeHTML(p.cliente)}</div>
                                            <div class="pedido-fecha">${fechaStr}</div>
                                        </div>
                                        <div class="col-base">${p.base.toFixed(2)}€</div>
                                        <div class="col-comision">-${p.comision.toFixed(2)}€</div>
                                        <div class="col-demora ${tieneDemora ? 'tiene-demora' : ''}">
                                            ${tieneDemora ? `-${p.descuentoDemora.toFixed(2)}€<span class="minutos">(${p.demoraMinutos} min)</span>` : '—'}
                                        </div>
                                        <div class="col-liquidar">${p.liquidar.toFixed(2)}€</div>
                                    </div>
                                `;
                            }
                        }
                        html += `</div>`;
                        
                        if (totalDemoras > 0) {
                            const pedidosConDemora = pedidosDetalle.filter(p => p.demoraMinutos > 0).length;
                            const promedioDemora = pedidosConDemora > 0 ? (totalDemoras / pedidosConDemora) : 0;
                            
                            html += `
                                <div class="resumen-demoras-box">
                                    <div class="titulo">⏱️ RESUMEN DE DEMORAS</div>
                                    <div class="stats">
                                        <div class="stat-item">
                                            <span class="label">Pedidos con demora</span>
                                            <span class="value red">${pedidosConDemora}</span>
                                        </div>
                                        <div class="stat-item">
                                            <span class="label">Promedio</span>
                                            <span class="value gold">${promedioDemora.toFixed(1)} min</span>
                                        </div>
                                        <div class="stat-item">
                                            <span class="label">Total a descontar</span>
                                            <span class="value red">-${totalDescuentoDemora.toFixed(2)}€</span>
                                        </div>
                                    </div>
                                </div>
                            `;
                        }
                    }
                    
                    // ✅ Sección de liquidaciones recibidas
                    html += `
                        <div class="liquidaciones-section">
                            <div class="section-title">
                                <span class="title-text">💵 Liquidaciones Recibidas</span>
                                <span class="count-badge" id="liq-count-badge">0</span>
                            </div>
                            <div id="liquidaciones-contenedor">
                                <div class="liq-empty"><span class="icon">⏳</span>Cargando liquidaciones...</div>
                            </div>
                        </div>
                    `;
                    
                    content.innerHTML = html;
                    renderizarLiquidacionesEnGanancias();
                    
                    window._gananciasData = {
                        periodo: periodo,
                        totalPedidos: totalPedidos,
                        totalRepartos: totalRepartos,
                        totalVentas: totalVentas,
                        totalComisiones: totalComisiones,
                        totalDemoras: totalDemoras,
                        totalDescuentoDemora: totalDescuentoDemora,
                        totalRepartosMonto: totalRepartosMonto,
                        totalLiquidar: totalLiquidar,
                        detalle: pedidosDetalle,
                        comisionPorcentaje: comisionPorcentaje,
                        comisionTipo: comisionTipo,
                        costoDemora: costoDemora
                    };
                    
                }).catch(error => {
                    console.error('Error cargando ganancias:', error);
                    content.innerHTML = `<div class="empty"><div class="icon">❌</div><div>Error al cargar datos: ${error.message}</div></div>`;
                });
            };

            // ============================================
            // EXPORTAR GANANCIAS EXCEL - CON DEMORAS Y REPARTOS
            // ============================================
            window.exportarGananciasExcel = function() {
                const data = window._gananciasData;
                if (!data || data.detalle.length === 0) {
                    Swal.fire({
                        title: '⚠️ Sin datos',
                        text: 'No hay datos para exportar en este período',
                        icon: 'warning',
                        background: '#0f172a',
                        color: 'white'
                    });
                    return;
                }
                
                let csv = "Pedido,Cliente,Tipo,Base (Neto),Comisión,Demora (min),Descuento Demora,A Liquidar,Fecha\n";
                for (const p of data.detalle) {
                    const fechaStr = p.fecha ? p.fecha.toLocaleDateString() : 'Sin fecha';
                    const tipo = p.esReparto ? 'Reparto Personal' : 'Pedido';
                    const liquidarFila = p.esReparto ? -p.montoReparto : p.liquidar;
                    csv += `"${p.id}","${p.cliente}","${tipo}",${p.base.toFixed(2)},${p.comision.toFixed(2)},${p.demoraMinutos},${p.descuentoDemora.toFixed(2)},${liquidarFila.toFixed(2)},"${fechaStr}"\n`;
                }
                
                csv += `\n"RESUMEN","","","","","","","",""\n`;
                csv += `"Total Pedidos",${data.totalPedidos},"","","","","","",""\n`;
                csv += `"Total Repartos",${data.totalRepartos || 0},"","","","","","",""\n`;
                csv += `"Total Base",${data.totalVentas.toFixed(2)}€,"","","","","","",""\n`;
                csv += `"Total Comisiones",-${data.totalComisiones.toFixed(2)}€,"","","","","","",""\n`;
                csv += `"Total Demoras (min)",${data.totalDemoras},"","","","","","",""\n`;
                csv += `"Total Descuento Demoras",-${data.totalDescuentoDemora.toFixed(2)}€,"","","","","","",""\n`;
                if (data.totalRepartos > 0) {
                    csv += `"Total Repartos Personales",-${(data.totalRepartosMonto || 0).toFixed(2)}€,"","","","","","",""\n`;
                }
                csv += `"TOTAL A LIQUIDAR",${data.totalLiquidar.toFixed(2)}€,"","","","","","",""\n`;
                
                const blob = new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8;" });
                const link = document.createElement("a");
                const url = URL.createObjectURL(blob);
                link.href = url;
                link.setAttribute("download", `ganancias_${data.periodo}_${new Date().toISOString().slice(0,10)}.csv`);
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(url);
                
                Swal.fire({
                    title: '✅ Reporte exportado',
                    text: `Se exportaron ${data.detalle.length} operaciones`,
                    icon: 'success',
                    timer: 2500,
                    showConfirmButton: false,
                    background: '#0f172a',
                    color: 'white'
                });
            };
            // ============================================
            // 28. MENÚ NAVEGACIÓN
            // ============================================
            document.querySelectorAll('.nav-item[data-view]').forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    const view = this.dataset.view;
                    
                    document.querySelectorAll('.nav-item[data-view]').forEach(el => {
                        el.classList.remove('active');
                    });
                    this.classList.add('active');
                    
                    currentView = view;
                    renderizarVista();
                });
            });

            // ============================================
            // 29. LIMPIAR HISTORIAL
            // ============================================
            window.limpiarHistorial = async function() {
                const user = firebase.auth().currentUser;
                if (!user) {
                    showToast('❌ Debes iniciar sesión', 'error');
                    return;
                }
                
                const adminSnap = await db.ref(`usuarios/${user.uid}/rol`).once('value');
                if (adminSnap.val() !== 'admin') {
                    showToast('❌ Solo el administrador puede limpiar el historial', 'error');
                    return;
                }
                
                const confirm = await Swal.fire({
                    title: '⚠️ ¿Limpiar historial?',
                    text: 'Esta acción eliminará todos los pedidos finalizados (ENTREGADOS, LISTOS, CANCELADOS). ¿Estás seguro?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, limpiar',
                    cancelButtonText: 'Cancelar',
                    background: '#0f172a',
                    color: 'white',
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#334155'
                });
                
                if (!confirm.isConfirmed) return;
                
                try {
                    const pedidos = await db.ref('pedidos').once('value');
                    const updates = {};
                    let count = 0;
                    
                    for (const [id, data] of Object.entries(pedidos.val() || {})) {
                        const restId = data.restauranteId || data.restaurante_id || data.uid_restaurante;
                        if (restId === restauranteId) {
                            const estado = data.estado ? data.estado.toUpperCase() : '';
                            if (estado === 'ENTREGADO' || estado === 'LISTO' || estado === 'CANCELADO' || estado === 'RECHAZADO') {
                                updates[id] = null;
                                count++;
                            }
                        }
                    }
                    
                    if (count === 0) {
                        showToast('📭 No hay pedidos para limpiar', 'info');
                        return;
                    }
                    
                    await db.ref('pedidos').update(updates);
                    showToast(`✅ ${count} pedidos eliminados del historial`, 'success');
                    renderizarVista();
                    
                } catch (error) {
                    console.error('Error limpiando historial:', error);
                    showToast('❌ Error al limpiar historial', 'error');
                }
            };

            // ============================================
            // 30. INICIO
            // ============================================
            console.log('✅ App móvil lista');

            window.addEventListener('pageshow', function(event) {
                if (event.persisted) {
                    location.reload();
                }
            });
        }

        // ============================================
        // INICIAR LA APP
        // ============================================
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', iniciarApp);
        } else {
            iniciarApp();
        }
    </script>
    
    <!-- ============================================
    REGISTRO DE SERVICE WORKER (PWA)
    ============================================ -->
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker
    .register('/cocina-movil/service-worker.js', {
        scope: '/cocina-movil/'
    })
                .then(reg => {
                    reg.addEventListener('updatefound', () => {
                        const newWorker = reg.installing;
                        newWorker.addEventListener('statechange', () => {
                            if (newWorker.state === 'activated') {
                                if (confirm('🔄 Hay una nueva versión disponible. ¿Actualizar ahora?')) {
                                    window.location.reload();
                                }
                            }
                        });
                    });
                })
                .catch(err => {
                    console.error('❌ Error registrando PWA:', err);
                });
        }
    </script>

</body>
</html>
