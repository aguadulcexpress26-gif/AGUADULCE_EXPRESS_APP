    // 🔥 ELIMINAR CONTENEDORES EXISTENTES
    const hc = document.getElementById('historial-container');
    if (hc) hc.remove();
    
    const dc = document.getElementById('demoras-container');
    if (dc) dc.remove();
    
    // 🔥 RESTAURAR COLUMNAS
    restaurarVistaColumnas();
    
    // Mostrar columnas por defecto
    const col1 = document.getElementById('columna-pendiente');
    const col2 = document.getElementById('columna-coccion');
    const col3 = document.getElementById('columna-listo');
    
    if (col1) col1.style.display = 'flex';
    if (col2) col2.style.display = 'flex';
    if (col3) col3.style.display = 'flex';
    
    if (currentView === 'historial') {
        if (col1) col1.style.display = 'none';
        if (col2) col2.style.display = 'none';
        if (col3) col3.style.display = 'none';
        mostrarVistaHistorial();
        return;
    }
    
    if (currentView === 'demoras') {
        if (col1) col1.style.display = 'none';
        if (col2) col2.style.display = 'none';
        if (col3) col3.style.display = 'none';
        mostrarVistaDemoras();
        return;
    }
    
    // Pedidos Activos
    cargarPedidosActivos();
}

